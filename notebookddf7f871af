{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":5,"nbformat":4,"cells":[{"id":"86e47cd6-ef9a-4a0c-a182-4042ba1234d6","cell_type":"code","source":"# Writes the `sosbench` package (all the code) into the working directory and checks the GPUs.\nimport os, sys, json, pickle, glob\nWORK = '/kaggle/working' if os.path.exists('/kaggle/working') else os.getcwd()\nos.chdir(WORK)\nFILES = {\"sosbench/__init__.py\": \"\\\"\\\"\\\"sosbench \\u2014 re-implementation of DenOiS (Bezek & Goksel 2026) and of the two\\ndifferentiable SoS methods of Meng (2026, MSc thesis): DAS+CMPE and SSFM,\\nevaluated on the public IMPACT ultrasound datasets (Ali et al. 2023).\\\"\\\"\\\"\\n__version__ = '1.0'\\n\", \"sosbench/acq.py\": \"\\\"\\\"\\\"Acquisition side: data loading (IMPACT .mat files), plane-wave synthesis from\\nfull-synthetic-aperture (FSA) data, plane-wave delay-and-sum beamforming and\\ninter-transmit displacement (delay) tracking.  Produces the DenOiS observations b'.\\n\\\"\\\"\\\"\\nimport numpy as np\\nfrom dataclasses import dataclass, field\\n\\n# ----------------------------------------------------------------------------- data\\n\\nIMPACT_URL = 'https://github.com/rehmanali1994/IMPACT/releases/download/v1.0.0/'\\nIMPACT_FILES = {\\n    'abd3':    dict(file='AbdominalMap3.mat', var='scat', fc=8e6, bw=12e6, gt=True),\\n    'abd4':    dict(file='AbdominalMap4.mat', var='scat', fc=8e6, bw=12e6, gt=True),\\n    'phantom': dict(file='PhantomL12-5-50mm.mat', var='fsr_dataset_fund', fc=6e6, bw=6e6, gt=False),\\n    'rat':     dict(file='RatAbdomenL12-3v.mat', var='full_synth_data', fc=7.5e6, bw=9e6, gt=False),\\n}\\n\\n\\ndef download_impact(names=('abd3', 'abd4', 'phantom', 'rat'), root='impact_data'):\\n    import os, urllib.request\\n    os.makedirs(root, exist_ok=True)\\n    for n in names:\\n        fn = IMPACT_FILES[n]['file']; dst = os.path.join(root, fn)\\n        if not os.path.exists(dst):\\n            print('downloading', fn, '...', flush=True)\\n            urllib.request.urlretrieve(IMPACT_URL + fn, dst)\\n    return root\\n\\n\\ndef _read_mat73(path, keys):\\n    \\\"\\\"\\\"MATLAB v7.3 (HDF5) reader. Uses h5py (Kaggle); falls back to pyfive.\\\"\\\"\\\"\\n    out = {}\\n    try:\\n        import h5py\\n        with h5py.File(path, 'r') as f:\\n            for k in keys:\\n                if k in f: out[k] = np.asarray(f[k]).T\\n        return out\\n    except ImportError:\\n        import sys; sys.path.insert(0, '/home/claude/ext')\\n        from matload import load\\n        d = load(path)\\n        return {k: d[k] for k in keys if k in d}\\n\\n\\ndef load_impact(name, root='impact_data', n_center_elements=128):\\n    \\\"\\\"\\\"Returns dict with\\n        scat  : (nt, nrx, ntx) float32 FSA channel data\\n        t     : (nt,) time axis [s]\\n        elx   : (nel,) element x positions [m]\\n        fc,bw : centre frequency / bandwidth [Hz]\\n        C,xC,zC (if ground truth available)\\n    For probes with more than `n_center_elements`, the central sub-aperture is\\n    kept so that every dataset shares the same 128-element geometry as the\\n    training simulations.\\\"\\\"\\\"\\n    import os\\n    meta = IMPACT_FILES[name]\\n    d = _read_mat73(os.path.join(root, meta['file']), [meta['var'], 'time', 'rxAptPos', 'C', 'x', 'z'])\\n    scat = d[meta['var']].astype(np.float32)          # (nt, nrx, ntx)\\n    elx = d['rxAptPos'][:, 0].astype(np.float64)\\n    nel = elx.size\\n    if n_center_elements and nel > n_center_elements:\\n        s = (nel - n_center_elements) // 2\\n        sl = slice(s, s + n_center_elements)\\n        scat = scat[:, sl, sl]; elx = elx[sl]\\n    out = dict(name=name, scat=np.ascontiguousarray(scat), t=d['time'].ravel().astype(np.float64),\\n               elx=elx, fc=meta['fc'], bw=meta['bw'], has_gt=meta['gt'])\\n    if meta['gt']:\\n        out.update(C=d['C'].astype(np.float32), xC=d['x'].ravel(), zC=d['z'].ravel())\\n    return out\\n\\n\\n# ----------------------------------------------------------------------------- geometry\\n\\n@dataclass\\nclass Geometry:\\n    \\\"\\\"\\\"Acquisition + reconstruction geometry shared by every part of DenOiS.\\\"\\\"\\\"\\n    elx: np.ndarray                       # element x [m]\\n    fc: float = 8e6\\n    c_bf: float = 1540.0                  # beamforming / reference speed of sound\\n    tx_mode: str = 'pw'                   # 'pw' plane waves | 'dw' diverging waves (virtual sources)\\n    n_tx: int = 9\\n    angles_deg: tuple = tuple(np.linspace(-16, 16, 9))   # used when tx_mode == 'pw'\\n    dw_subap: int = 64                    # elements per diverging-wave sub-aperture\\n    dw_zv: float = 4e-3                   # virtual source depth behind the array [m]\\n    # reconstruction grid (DenOiS: 64x64)\\n    nz: int = 64\\n    nx: int = 64\\n    dz: float = 0.6e-3\\n    dx: float = 0.4e-3                    # 64*0.4 mm = 25.6 mm = aperture width\\n    # beamforming grid oversampling inside one reconstruction pixel\\n    bf_sub_z: int = 12\\n    bf_sub_x: int = 4\\n    fnum_rx: float = 1.0\\n    zmin_valid: float = 2e-3              # near-field cut for measurements\\n    track_win_z: int = 2                  # tracking window in recon pixels (axial)\\n    track_win_x: int = 2                  # tracking window in recon pixels (lateral)\\n\\n    def __post_init__(self):\\n        self.elx = np.asarray(self.elx, dtype=np.float64)\\n        self.xc = float(self.elx.mean())\\n        self.angles = np.deg2rad(np.asarray(self.angles_deg, dtype=np.float64))\\n        self.z = (np.arange(self.nz) + 0.5) * self.dz                       # pixel centres\\n        self.x = self.xc + (np.arange(self.nx) - (self.nx - 1) / 2) * self.dx\\n        self.zb = (np.arange(self.nz * self.bf_sub_z) + 0.5) * self.dz / self.bf_sub_z\\n        self.xb = self.xc + (np.arange(self.nx * self.bf_sub_x) - (self.nx * self.bf_sub_x - 1) / 2) * self.dx / self.bf_sub_x\\n        lo, hi = self.elx.min(), self.elx.max()\\n        nel = len(self.elx)\\n        if self.tx_mode == 'pw':\\n            self.n_tx = len(self.angles)\\n            self.tx_delay = np.zeros((self.n_tx, nel)); self.tx_apod = np.ones((self.n_tx, nel))\\n            for a, th in enumerate(self.angles):\\n                xref = lo if np.sin(th) >= 0 else hi\\n                self.tx_delay[a] = (self.elx - xref) * np.sin(th) / self.c_bf\\n        else:\\n            # virtual sources evenly spread so that every sub-aperture fits in the array\\n            half = (self.dw_subap - 1) / 2 * np.mean(np.diff(self.elx))\\n            self.vx = np.linspace(lo + half, hi - half, self.n_tx)\\n            self.tx_delay = np.zeros((self.n_tx, nel)); self.tx_apod = np.zeros((self.n_tx, nel))\\n            for k, xv in enumerate(self.vx):\\n                sel = np.abs(self.elx - xv) <= half + 1e-9\\n                r = np.sqrt((self.elx - xv) ** 2 + self.dw_zv ** 2)\\n                self.tx_apod[k, sel] = 1.0\\n                self.tx_delay[k] = np.where(sel, (r - self.dw_zv) / self.c_bf, 0.0)\\n            self.dw_half = half\\n        self.npair = self.n_tx - 1\\n\\n    def t_tx(self, k, Z, X, c=None):\\n        \\\"\\\"\\\"Nominal transmit arrival time at points (Z, X) for transmit k (backend-agnostic).\\\"\\\"\\\"\\n        c = c or self.c_bf\\n        if self.tx_mode == 'pw':\\n            th = float(self.angles[k]); xref = self.elx.min() if np.sin(th) >= 0 else self.elx.max()\\n            return ((X - xref) * float(np.sin(th)) + Z * float(np.cos(th))) / c\\n        xv, zv = float(self.vx[k]), self.dw_zv\\n        return (((X - xv) ** 2 + (Z + zv) ** 2) ** 0.5 - zv) / c\\n\\n    def ray_entry(self, k, Z, X):\\n        \\\"\\\"\\\"Skin-entry x of the transmit ray reaching (Z, X), and whether it lies\\n        inside the insonifying aperture (numpy).\\\"\\\"\\\"\\n        if self.tx_mode == 'pw':\\n            x0 = X - Z * np.tan(self.angles[k])\\n            return x0, (x0 >= self.elx.min()) & (x0 <= self.elx.max())\\n        xv, zv = self.vx[k], self.dw_zv\\n        x0 = xv + (X - xv) * zv / (Z + zv)\\n        return x0, np.abs(x0 - xv) <= self.dw_half\\n\\n    @property\\n    def extent_mm(self):\\n        return [1e3 * (self.x[0] - self.dx / 2), 1e3 * (self.x[-1] + self.dx / 2),\\n                1e3 * (self.z[-1] + self.dz / 2), 1e3 * (self.z[0] - self.dz / 2)]\\n\\n\\ndef default_geometry(elx=None, **kw):\\n    \\\"\\\"\\\"Training/evaluation geometry: 128-element, 0.2 mm pitch linear array (as in the\\n    IMPACT k-Wave data), 9 steered plane waves in [-16, 16] deg (8 transmit pairs ->\\n    8 delay maps), 64x64 reconstruction grid.  ('dw' = diverging waves is available\\n    but decorrelates strongly between neighbouring virtual sources on this probe.)\\\"\\\"\\\"\\n    if elx is None:\\n        elx = -12.56e-3 + 0.2e-3 * np.arange(128)\\n    args = dict(tx_mode='pw', n_tx=9, angles_deg=tuple(np.linspace(-16, 16, 9)), fc=8e6)\\n    args.update(kw)\\n    return Geometry(elx=elx, **args)\\n\\n\\n# ----------------------------------------------------------------------------- FSA -> plane waves\\n\\ndef fsa_to_pw_iq(scat, t, geo, fc, bw, fs_out=16e6, t_max=70e-6, rx_chunk=16):\\n    \\\"\\\"\\\"Synthesise the geometry's transmits (plane or diverging waves) from FSA data\\n    in the frequency domain, and return baseband IQ channel data.\\n        scat: (nt, nrx, ntx) real; returns iq (n_tx, nrx, nt_out) complex64, t_out (nt_out,)\\\"\\\"\\\"\\n    nt, nrx, ntx = scat.shape\\n    fs = 1.0 / np.mean(np.diff(t))\\n    f = np.fft.rfftfreq(nt, 1 / fs)\\n    band = np.where((f > max(fc - bw / 2, 0.2e6)) & (f < fc + bw / 2))[0]\\n    fb = f[band]\\n    tau = geo.tx_delay[:, :ntx]\\n    Ptx = (np.exp(-2j * np.pi * fb[:, None, None] * tau[None, :, :]) * geo.tx_apod[None, :, :ntx]).astype(np.complex64)\\n    nt_out = int(np.ceil((t_max - t[0]) * fs_out))\\n    t_out = t[0] + np.arange(nt_out) / fs_out\\n    # baseband DFT synthesis matrix: spectrum referenced to t[0]\\n    E = np.exp(2j * np.pi * fb[:, None] * (t_out[None, :] - t[0])\\n               - 2j * np.pi * fc * t_out[None, :]).astype(np.complex64)                    # (nf, nt_out)\\n    iq = np.zeros((geo.n_tx, nrx, nt_out), np.complex64)\\n    for r0 in range(0, nrx, rx_chunk):\\n        S = np.fft.rfft(scat[:, r0:r0 + rx_chunk, :], axis=0)[band].astype(np.complex64)     # (nf, nrc, ntx)\\n        Y = np.einsum('frt,fat->afr', S, Ptx, optimize=True)                                 # (nang, nf, nrc)\\n        iq[:, r0:r0 + rx_chunk, :] = np.einsum('afr,fn->arn', Y, E, optimize=True) * (2.0 / nt)\\n    return iq, t_out\\n\\n\\n# ----------------------------------------------------------------------------- beamforming\\n\\ndef beamform_pw(B, iq, t_out, geo: Geometry, c=None, rx_chunk=32, ang_idx=None):\\n    \\\"\\\"\\\"Plane/diverging-wave DAS with constant speed `c` on the fine grid (geo.zb, geo.xb).\\n    iq: (nang, nrx, nt) complex (backend array); returns (nang, nzb, nxb) complex.\\\"\\\"\\\"\\n    c = c or geo.c_bf\\n    zb = B.asarray(geo.zb, np.float32)[:, None]; xb = B.asarray(geo.xb, np.float32)[None, :]\\n    elx = geo.elx\\n    t0 = float(t_out[0]); fs = 1.0 / float(t_out[1] - t_out[0]); nt = iq.shape[-1]\\n    ang_idx = range(geo.n_tx) if ang_idx is None else ang_idx\\n    out = []\\n    for a in ang_idx:\\n        t_tx = geo.t_tx(a, zb, xb, c)                                                    # (nz, nx)\\n        img = B.zeros((len(geo.zb), len(geo.xb)), B.cfloat)\\n        for r0 in range(0, len(elx), rx_chunk):\\n            ex = B.asarray(elx[r0:r0 + rx_chunk], np.float32)[:, None, None]\\n            dxr = xb[None] - ex\\n            t_rx = B.sqrt(dxr ** 2 + zb[None] ** 2) / c                                  # (nr, nz, nx)\\n            tau = t_tx[None] + t_rx\\n            apod = (B.abs(dxr) * 2 * geo.fnum_rx <= zb[None]).astype(np.float32) if B.name == 'numpy' \\\\\\n                else (B.abs(dxr) * 2 * geo.fnum_rx <= zb[None]).float()\\n            idx = (tau - t0) * fs\\n            i0 = B.clip(B.floor(idx), 0, nt - 2)\\n            w = idx - i0\\n            i0l = i0.astype(np.int64) if B.name == 'numpy' else i0.long()\\n            sig = iq[a, r0:r0 + rx_chunk]                                                 # (nr, nt)\\n            nr = sig.shape[0]\\n            flat = i0l.reshape(nr, -1)\\n            s0 = B.take_along(sig, flat, 1).reshape(i0l.shape)\\n            s1 = B.take_along(sig, flat + 1, 1).reshape(i0l.shape)\\n            val = (s0 * (1 - w) + s1 * w) * B.polar(2 * np.pi * geo.fc * tau) * apod\\n            valid = (idx >= 0) & (idx <= nt - 1)\\n            val = val * (valid.astype(np.float32) if B.name == 'numpy' else valid.float())\\n            img = img + B.sum(val, axis=0)\\n        out.append(img)\\n    return B.stack(out, 0)\\n\\n\\n# ----------------------------------------------------------------------------- tracking\\n\\ndef _box_sum(B, x, kz, kx):\\n    \\\"\\\"\\\"Centred box sum over (kz, kx) along the last two axes (zero padded).\\n    Padding is done by concatenation so it works for complex tensors on any backend.\\\"\\\"\\\"\\n    def along(x, k, axis):\\n        n = x.shape[axis]\\n        before, after = k // 2 + 1, k - k // 2 - 1\\n        def sl(a, b):\\n            idx = [slice(None)] * x.ndim; idx[axis] = slice(a, b); return tuple(idx)\\n        parts = [0 * x[sl(0, before)], x]\\n        if after > 0: parts.append(0 * x[sl(0, after)])\\n        cs = B.cumsum(B.cat(parts, axis), axis)\\n        return cs[sl(k, k + n)] - cs[sl(0, n)]\\n    return along(along(x, kz, -2), kx, -1)\\n\\n\\ndef track_delays(B, imgs, geo: Geometry, cycle_fix=False, max_lag=5):\\n    \\\"\\\"\\\"Inter-transmit delays between consecutive frames (NCC-style tracking).\\n    1) fine estimate: phase of the zero-lag normalised complex cross-correlation in\\n       a sliding window  ->  precise but ambiguous modulo 1/fc (default output);\\n    2) [cycle_fix=True, for large delays e.g. diverging waves] coarse estimate: axial lag (in beamforming samples, +-max_lag, parabolic\\n       sub-sample refinement) maximising the windowed |cross-correlation|, converted\\n       to time with dt/dz = (cos(tx angle) + cos(rx angle))/c;\\n    3) the fine estimate is moved to the 1/fc cycle closest to the coarse one.\\n    imgs: (ntx, nzb, nxb) complex.  Returns\\n        delay_ns (npair, nz, nx)  : tau_{k+1} - tau_k  [ns]\\n        rho      (npair, nz, nx)  : normalised (zero-lag) correlation magnitude\\\"\\\"\\\"\\n    kz = geo.track_win_z * geo.bf_sub_z; kx = geo.track_win_x * geo.bf_sub_x\\n    a = imgs[:-1]; b = imgs[1:]\\n    nzb = a.shape[1]\\n    iz = B.asarray(np.arange(geo.nz) * geo.bf_sub_z + geo.bf_sub_z // 2)\\n    ix = B.asarray(np.arange(geo.nx) * geo.bf_sub_x + geo.bf_sub_x // 2)\\n    def sample(x): return x[:, iz][:, :, ix]\\n    cross0 = sample(_box_sum(B, b * B.conj(a), kz, kx))\\n    ea = sample(_box_sum(B, B.abs(a) ** 2, kz, kx)); eb = sample(_box_sum(B, B.abs(b) ** 2, kz, kx))\\n    rho = B.abs(cross0) / B.sqrt(ea * eb + 1e-30)\\n    fine = -B.angle(cross0) / (2 * np.pi * geo.fc)                              # [s]\\n    if not cycle_fix:                       # plane waves: |delay| << 1/(2 fc), no wrapping\\n        return fine * 1e9, rho\\n    # coarse lag search on |xcorr|\\n    mags = []\\n    for lag in range(-max_lag, max_lag + 1):\\n        if lag >= 0:\\n            bs = B.cat([b[:, lag:], 0 * b[:, :lag]], axis=1) if lag > 0 else b\\n        else:\\n            bs = B.cat([0 * b[:, :(-lag)], b[:, :lag]], axis=1)\\n        mags.append(B.abs(sample(_box_sum(B, bs * B.conj(a), kz, kx))))\\n    M = B.stack(mags, 0)                                                        # (nlag, np, nz, nx)\\n    if B.name == 'numpy':\\n        k = M.argmax(0)\\n    else:\\n        k = M.argmax(0)\\n    kc = B.clip(k, 1, 2 * max_lag - 1)\\n    kcl = kc if B.name == 'numpy' else kc.long()\\n    take = lambda off: B.take_along(M, (kcl + off)[None], 0)[0]\\n    ym, y0, yp = take(-1), take(0), take(1)\\n    den = ym - 2 * y0 + yp\\n    frac = B.where(B.abs(den) > 1e-12, 0.5 * (ym - yp) / (den + 1e-30), 0 * den)\\n    frac = B.clip(frac, -0.5, 0.5)\\n    lag = (kc - max_lag) + frac                                                 # bf samples\\n    dzb = geo.dz / geo.bf_sub_z\\n    # dt/dz at the measurement points (mean of the two transmits' ray angles, rx ~ normal)\\n    Z, X = np.meshgrid(geo.z, geo.x, indexing='ij')\\n    cosk = []\\n    for k_ in range(geo.npair):\\n        x0a, _ = geo.ray_entry(k_, Z, X); x0b, _ = geo.ray_entry(k_ + 1, Z, X)\\n        ca = Z / np.sqrt((X - x0a) ** 2 + Z ** 2); cb = Z / np.sqrt((X - x0b) ** 2 + Z ** 2)\\n        cosk.append(0.5 * (ca + cb))\\n    dtdz = B.asarray(((np.stack(cosk) + 0.95) / geo.c_bf).astype(np.float32))\\n    coarse = lag * dzb * dtdz                                                   # [s]\\n    T = 1.0 / geo.fc\\n    n = B.floor((coarse - fine) / T + 0.5)\\n    delay_ns = (fine + n * T) * 1e9\\n    return delay_ns, rho\\n\\n\\ndef observations_from_fsa(data, geo: Geometry, B=None, fs_out=16e6):\\n    \\\"\\\"\\\"Full real-data pipeline: FSA -> 9 plane waves -> DAS -> tracking.\\n    Returns delay_ns (npair,nz,nx), rho (npair,nz,nx), bmode_db (nzb,nxb) (compounded).\\\"\\\"\\\"\\n    from .backend import get_backend\\n    B = B or get_backend('numpy')\\n    t_max = 2.2 * (geo.z[-1] + geo.dz) / 1400 + 3e-6\\n    iq, t_out = fsa_to_pw_iq(data['scat'], data['t'], geo, data['fc'], data['bw'], fs_out=fs_out, t_max=t_max)\\n    iq = B.asarray(iq)\\n    imgs = beamform_pw(B, iq, t_out, geo)\\n    d, r = track_delays(B, imgs, geo)\\n    comp = B.to_numpy(B.abs(B.sum(imgs, 0)))\\n    bmode = 20 * np.log10(comp / comp.max() + 1e-6)\\n    return B.to_numpy(d), B.to_numpy(r), bmode\\n\", \"sosbench/backend.py\": \"\\\"\\\"\\\"Tiny array-backend shim so the physics kernels run on NumPy (CPU, testing)\\nor PyTorch (GPU, autograd).  Only the operations used in this package are wrapped.\\n\\nUsage:\\n    B = get_backend('torch', device='cuda:0')   # or get_backend('numpy')\\n    x = B.asarray(np_array)\\n\\\"\\\"\\\"\\nimport numpy as np\\n\\n\\nclass NumpyBackend:\\n    name = 'numpy'\\n    device = 'cpu'\\n    cfloat = np.complex64\\n    float = np.float32\\n    pi = np.pi\\n\\n    def asarray(self, x, dtype=None):\\n        if hasattr(x, 'detach'):                      # torch tensor -> numpy\\n            x = x.detach().cpu().numpy()\\n        return np.asarray(x, dtype=dtype)\\n\\n    def to_numpy(self, x):\\n        return np.asarray(x)\\n\\n    def zeros(self, shape, dtype=None):\\n        return np.zeros(shape, dtype=dtype or np.float32)\\n\\n    def ones(self, shape, dtype=None):\\n        return np.ones(shape, dtype=dtype or np.float32)\\n\\n    def arange(self, *a, dtype=None):\\n        return np.arange(*a, dtype=dtype or np.float32)\\n\\n    def linspace(self, a, b, n):\\n        return np.linspace(a, b, n, dtype=np.float32)\\n\\n    # elementwise\\n    exp = staticmethod(np.exp); sqrt = staticmethod(np.sqrt); abs = staticmethod(np.abs)\\n    angle = staticmethod(np.angle); conj = staticmethod(np.conj); real = staticmethod(np.real)\\n    imag = staticmethod(np.imag); sin = staticmethod(np.sin); cos = staticmethod(np.cos)\\n    tan = staticmethod(np.tan); floor = staticmethod(np.floor); log = staticmethod(np.log)\\n    log1p = staticmethod(np.log1p); maximum = staticmethod(np.maximum); minimum = staticmethod(np.minimum)\\n    where = staticmethod(np.where); sign = staticmethod(np.sign); atan2 = staticmethod(np.arctan2)\\n\\n    def clip(self, x, lo=None, hi=None):\\n        return np.clip(x, lo, hi)\\n\\n    def csqrt(self, x):\\n        return np.sqrt(x.astype(np.complex64))\\n\\n    def polar(self, phase):\\n        return np.exp(1j * phase).astype(np.complex64)\\n\\n    def complex(self, re, im):\\n        return (re + 1j * im).astype(np.complex64)\\n\\n    def sum(self, x, axis=None, keepdims=False):\\n        return np.sum(x, axis=axis, keepdims=keepdims)\\n\\n    def mean(self, x, axis=None, keepdims=False):\\n        return np.mean(x, axis=axis, keepdims=keepdims)\\n\\n    def cumsum(self, x, axis):\\n        return np.cumsum(x, axis=axis)\\n\\n    def stack(self, xs, axis=0):\\n        return np.stack(xs, axis=axis)\\n\\n    def cat(self, xs, axis=0):\\n        return np.concatenate(xs, axis=axis)\\n\\n    def einsum(self, eq, *ops):\\n        return np.einsum(eq, *ops, optimize=True)\\n\\n    def fft(self, x, axis=-1):\\n        return np.fft.fft(x, axis=axis).astype(np.complex64)\\n\\n    def ifft(self, x, axis=-1):\\n        return np.fft.ifft(x, axis=axis).astype(np.complex64)\\n\\n    def fftfreq(self, n, d):\\n        return np.fft.fftfreq(n, d).astype(np.float32)\\n\\n    def take_along(self, x, idx, axis):\\n        return np.take_along_axis(x, idx, axis=axis)\\n\\n    def pad(self, x, pads):           # pads: list of (before, after) per axis\\n        return np.pad(x, pads)\\n\\n    def spmm(self, A, x):             # scipy sparse @ dense\\n        return A @ x\\n\\n    def spmm_T(self, A, x):\\n        return A.T @ x\\n\\n    def sparse(self, A_scipy):\\n        return A_scipy.tocsr().astype(np.float32)\\n\\n    def interp2(self, img, zq, xq):\\n        \\\"\\\"\\\"Bilinear sample img[Nz,Nx] at fractional index coords (zq, xq) (any shape),\\n        clamped at the border.\\\"\\\"\\\"\\n        Nz, Nx = img.shape\\n        zq = np.clip(zq, 0, Nz - 1); xq = np.clip(xq, 0, Nx - 1)\\n        z0 = np.clip(np.floor(zq).astype(np.int64), 0, Nz - 2); x0 = np.clip(np.floor(xq).astype(np.int64), 0, Nx - 2)\\n        wz = zq - z0; wx = xq - x0\\n        return ((1 - wz) * (1 - wx) * img[z0, x0] + (1 - wz) * wx * img[z0, x0 + 1]\\n                + wz * (1 - wx) * img[z0 + 1, x0] + wz * wx * img[z0 + 1, x0 + 1])\\n\\n    def median3(self, x):\\n        from scipy.ndimage import median_filter\\n        return median_filter(x, size=3, mode='nearest')\\n\\n    def no_grad(self):\\n        import contextlib\\n        return contextlib.nullcontext()\\n\\n\\nclass TorchBackend:\\n    name = 'torch'\\n\\n    def __init__(self, device='cuda'):\\n        import torch\\n        self.torch = torch\\n        self.device = torch.device(device)\\n        self.cfloat = torch.complex64\\n        self.float = torch.float32\\n        self.pi = float(np.pi)\\n\\n    def _dt(self, dtype):\\n        t = self.torch\\n        if dtype is None: return None\\n        m = {np.float32: t.float32, np.float64: t.float64, np.complex64: t.complex64,\\n             np.int64: t.int64, np.bool_: t.bool, float: t.float32, complex: t.complex64, bool: t.bool}\\n        if isinstance(dtype, t.dtype): return dtype\\n        return m.get(dtype, m.get(np.dtype(dtype).type))\\n\\n    def asarray(self, x, dtype=None):\\n        t = self.torch\\n        if isinstance(x, t.Tensor):\\n            x = x.to(self.device)\\n            return x.to(self._dt(dtype)) if dtype is not None else x\\n        x = np.asarray(x)\\n        if dtype is None:\\n            if x.dtype == np.float64: dtype = np.float32\\n            if x.dtype == np.complex128: dtype = np.complex64\\n        if dtype is not None: x = x.astype(dtype)\\n        return t.from_numpy(np.ascontiguousarray(x)).to(self.device)\\n\\n    def to_numpy(self, x):\\n        return x.detach().cpu().numpy() if hasattr(x, 'detach') else np.asarray(x)\\n\\n    def zeros(self, shape, dtype=None):\\n        return self.torch.zeros(shape, dtype=self._dt(dtype) or self.torch.float32, device=self.device)\\n\\n    def ones(self, shape, dtype=None):\\n        return self.torch.ones(shape, dtype=self._dt(dtype) or self.torch.float32, device=self.device)\\n\\n    def arange(self, *a, dtype=None):\\n        return self.torch.arange(*a, dtype=self._dt(dtype) or self.torch.float32, device=self.device)\\n\\n    def linspace(self, a, b, n):\\n        return self.torch.linspace(a, b, n, device=self.device)\\n\\n    def __getattr__(self, name):\\n        t = self.__dict__['torch']\\n        table = dict(exp=t.exp, sqrt=t.sqrt, abs=t.abs, angle=t.angle, conj=t.conj, real=t.real,\\n                     imag=t.imag, sin=t.sin, cos=t.cos, tan=t.tan, floor=t.floor, log=t.log,\\n                     log1p=t.log1p, maximum=t.maximum, minimum=t.minimum, where=t.where,\\n                     sign=t.sign, atan2=t.atan2)\\n        if name in table: return table[name]\\n        raise AttributeError(name)\\n\\n    def clip(self, x, lo=None, hi=None):\\n        return self.torch.clamp(x, lo, hi)\\n\\n    def csqrt(self, x):\\n        return self.torch.sqrt(x.to(self.torch.complex64))\\n\\n    def polar(self, phase):\\n        return self.torch.polar(self.torch.ones_like(phase), phase)\\n\\n    def complex(self, re, im):\\n        return self.torch.complex(re, im)\\n\\n    def sum(self, x, axis=None, keepdims=False):\\n        return x.sum() if axis is None else x.sum(dim=axis, keepdim=keepdims)\\n\\n    def mean(self, x, axis=None, keepdims=False):\\n        return x.mean() if axis is None else x.mean(dim=axis, keepdim=keepdims)\\n\\n    def cumsum(self, x, axis):\\n        return self.torch.cumsum(x, dim=axis)\\n\\n    def stack(self, xs, axis=0):\\n        return self.torch.stack(xs, dim=axis)\\n\\n    def cat(self, xs, axis=0):\\n        return self.torch.cat(xs, dim=axis)\\n\\n    def einsum(self, eq, *ops):\\n        return self.torch.einsum(eq, *ops)\\n\\n    def fft(self, x, axis=-1):\\n        return self.torch.fft.fft(x, dim=axis)\\n\\n    def ifft(self, x, axis=-1):\\n        return self.torch.fft.ifft(x, dim=axis)\\n\\n    def fftfreq(self, n, d):\\n        return self.torch.fft.fftfreq(n, d, device=self.device)\\n\\n    def take_along(self, x, idx, axis):\\n        return self.torch.take_along_dim(x, idx, dim=axis)\\n\\n    def pad(self, x, pads):\\n        flat = []\\n        for b, a in reversed(pads): flat += [b, a]\\n        return self.torch.nn.functional.pad(x, flat)\\n\\n    def sparse(self, A_scipy):\\n        A = A_scipy.tocoo()\\n        i = np.vstack([A.row, A.col]).astype(np.int64)\\n        T = self.torch.sparse_coo_tensor(self.torch.from_numpy(i), self.torch.from_numpy(A.data.astype(np.float32)),\\n                                         A.shape).coalesce().to(self.device)\\n        TT = self.torch.sparse_coo_tensor(self.torch.from_numpy(i[::-1].copy()),\\n                                          self.torch.from_numpy(A.data.astype(np.float32)),\\n                                          (A.shape[1], A.shape[0])).coalesce().to(self.device)\\n        return (T.to_sparse_csr(), TT.to_sparse_csr())\\n\\n    def spmm(self, A, x):\\n        squeeze = x.dim() == 1\\n        y = A[0] @ (x[:, None] if squeeze else x.contiguous())\\n        return y[:, 0] if squeeze else y\\n\\n    def spmm_T(self, A, x):\\n        squeeze = x.dim() == 1\\n        y = A[1] @ (x[:, None] if squeeze else x.contiguous())\\n        return y[:, 0] if squeeze else y\\n\\n    def interp2(self, img, zq, xq):\\n        \\\"\\\"\\\"Differentiable bilinear sampling of img[Nz,Nx] at fractional index coords.\\\"\\\"\\\"\\n        F = self.torch.nn.functional\\n        Nz, Nx = img.shape\\n        gx = 2 * xq / max(Nx - 1, 1) - 1\\n        gz = 2 * zq / max(Nz - 1, 1) - 1\\n        shp = xq.shape\\n        grid = self.torch.stack([gx.reshape(1, -1, 1), gz.reshape(1, -1, 1)], dim=-1)\\n        out = F.grid_sample(img[None, None], grid, mode='bilinear', padding_mode='border', align_corners=True)\\n        return out.reshape(shp)\\n\\n    def median3(self, x):\\n        F = self.torch.nn.functional\\n        p = F.pad(x[None, None], (1, 1, 1, 1), mode='replicate')\\n        u = p.unfold(2, 3, 1).unfold(3, 3, 1)\\n        return u.reshape(*u.shape[:4], 9).median(dim=-1).values[0, 0]\\n\\n    def no_grad(self):\\n        return self.torch.no_grad()\\n\\n\\ndef get_backend(name='numpy', device='cuda'):\\n    if name == 'numpy':\\n        return NumpyBackend()\\n    return TorchBackend(device)\\n\", \"sosbench/cli.py\": \"\\\"\\\"\\\"Command-line entry points used by the Kaggle notebooks (one process per GPU).\\n\\n    python -m sosbench.cli gen    --what S|C1|C1test|C2 --n N --seed S --out file.npz\\n    python -m sosbench.cli merge  --inputs a.npz b.npz --out c.npz\\n    python -m sosbench.cli real   --names abd3 abd4 phantom rat --root impact_data --out real.pkl\\n    python -m sosbench.cli eval   --ckpt ckpt --data data --real real.pkl --out results_denois\\n    python -m sosbench.cli thesis --method das|ssfm --name abd3 --root impact_data --out results_thesis\\n\\\"\\\"\\\"\\nimport argparse, json, os, pickle, time\\nimport numpy as np\\n\\n\\ndef _backend():\\n    import torch\\n    from .backend import get_backend\\n    dev = 'cuda' if torch.cuda.is_available() else 'cpu'\\n    return get_backend('torch', dev) if dev == 'cuda' else get_backend('numpy')\\n\\n\\ndef cmd_gen(a):\\n    from .acq import default_geometry\\n    from .datagen import Ops, gen_S, gen_C\\n    B = _backend(); geo = default_geometry()\\n    ops = Ops(B, geo, with_hi=(a.what == 'S'))\\n    t0 = time.time()\\n    if a.what == 'S':\\n        gen_S(ops, a.n, a.out, seed=a.seed, chunk=a.chunk)\\n    else:\\n        gen_C(B, ops, a.n, a.out, seed=a.seed, kind='structured' if a.what == 'C2' else 'quasi')\\n    print(f'done {a.what} n={a.n} in {(time.time() - t0) / 60:.1f} min', flush=True)\\n\\n\\ndef cmd_merge(a):\\n    ds = [np.load(p) for p in a.inputs]\\n    np.savez(a.out, **{k: np.concatenate([d[k] for d in ds]) for k in ds[0].files})\\n    print('merged ->', a.out, sum(len(d['x']) for d in ds), 'samples')\\n\\n\\ndef cmd_real(a):\\n    from .acq import default_geometry\\n    from .datagen import Ops, real_case\\n    B = _backend(); geo = default_geometry()\\n    ops = Ops(B, geo, with_hi=False)\\n    out = {}\\n    for n in a.names:\\n        t0 = time.time()\\n        c = real_case(B, ops, n, a.root)\\n        c.pop('geo')\\n        out[n] = c\\n        print(f'real {n}: {time.time() - t0:.0f}s', flush=True)\\n    with open(a.out, 'wb') as f:\\n        pickle.dump(out, f)\\n\\n\\ndef _stack(d, idx=None):\\n    keys = ['x', 'b', 'w', 'l1', 'l2']\\n    sl = slice(None) if idx is None else idx\\n    return {k: np.asarray(d[k][sl]).astype(np.float32) for k in keys}\\n\\n\\ndef cmd_eval(a):\\n    from .acq import default_geometry\\n    from .denois import DenoisRunner, score_grid, print_table\\n    from .metrics import all_metrics, roi_mask\\n    os.makedirs(a.out, exist_ok=True)\\n    geo = default_geometry()\\n    R = DenoisRunner(a.ckpt, geo, device='cuda')\\n    log = lambda s: print(s, flush=True)\\n    # --- tune the data-consistency weight nu on a few C1 validation cases (never on test data)\\n    pv = os.path.join(a.data, 'C1val.npz')\\n    val = _stack(np.load(pv)) if os.path.exists(pv) else _stack(np.load(os.path.join(a.data, 'C1.npz')), slice(-a.n_val, None))\\n    best = None\\n    for nu in a.nus:\\n        X = R.rd(val['b'], val['w'], val['l1'], val['l2'], nu=nu)\\n        r = np.mean([all_metrics(X[i], val['x'][i], geo)['RMSE'] for i in range(len(X))])\\n        log(f'nu={nu}: val RMSE {r:.2f}')\\n        if best is None or r < best[1]: best = (nu, r)\\n    R.nu = best[0]; log(f'selected nu={R.nu}')\\n    results = {'nu': R.nu}\\n    # --- simulated test sets\\n    for name in ['C1test', 'C2']:\\n        p = os.path.join(a.data, f'{name}.npz')\\n        if not os.path.exists(p): continue\\n        cs = _stack(np.load(p))\\n        log(f'== {name} ({len(cs[\\\"x\\\"])} cases)')\\n        grid, obs = R.run_grid(cs, real=False, log=log)\\n        tab = score_grid(grid, cs['x'], geo)\\n        log(print_table(tab, 'RMSE', 'ACE'))\\n        results[name] = dict(table={f'{k[0]}|{k[1]}': v for k, v in tab.items()})\\n        np.savez_compressed(os.path.join(a.out, f'{name}_recons.npz'), gt=cs['x'],\\n                            **{f'{i}|{r}': X for i, rs in grid.items() for r, X in rs.items()})\\n    # --- real data (IMPACT): abd3/abd4 have GT, phantom / rat qualitative\\n    with open(a.real, 'rb') as f:\\n        real = pickle.load(f)\\n    for name, c in real.items():\\n        cs = {k: c[k][None].astype(np.float32) for k in ['x', 'b', 'w', 'l1', 'l2']}\\n        log(f'== {name}')\\n        grid, obs = R.run_grid(cs, real=(name in ('phantom', 'rat')), log=log)\\n        rec = {f'{i}|{r}': X[0] for i, rs in grid.items() for r, X in rs.items()}\\n        entry = {}\\n        if np.isfinite(c['x']).all():\\n            entry['metrics'] = {k: all_metrics(v, c['x'], geo) for k, v in rec.items()}\\n            for k, v in entry['metrics'].items():\\n                log(f'   {k:<28} RMSE {v[\\\"RMSE\\\"]:6.2f}  MAE {v[\\\"MAE\\\"]:6.2f}')\\n        results[name] = entry\\n        np.savez_compressed(os.path.join(a.out, f'{name}_recons.npz'), gt=c['x'], bmode=c['bmode'],\\n                            b=c['b'], w=c['w'], **rec, **{f'obs|{k}': v[0] for k, v in obs.items()})\\n    with open(os.path.join(a.out, 'results.json'), 'w') as f:\\n        json.dump(results, f, indent=1, default=float)\\n    log('saved ' + a.out)\\n\\n\\ndef cmd_thesis(a):\\n    import torch\\n    from .acq import load_impact, default_geometry\\n    from .metrics import all_metrics\\n    from .raymodel import resample_gt\\n    os.makedirs(a.out, exist_ok=True)\\n    data = load_impact(a.name, a.root)\\n    geo = default_geometry(elx=data['elx'])\\n    log = lambda s: print(s, flush=True)\\n    t0 = time.time()\\n    if a.method == 'das':\\n        from .thesis_das import DASSetup, run_das_cmpe, ctrl_to_grid\\n        S = DASSetup(data)\\n        r = run_das_cmpe(S, device=a.devices[0], iters=a.iters, lam=a.lam_das, log=log)\\n        sos64 = ctrl_to_grid(r['c_ctrl'], r['ctrl_z'], r['ctrl_x'], geo.z, geo.x)\\n    else:\\n        from .thesis_ssfm import SSFMSetup, run_ssfm\\n        dov = min(40e-3, 0.95 * (data['t'][-1] * 1400 / 2))\\n        S = SSFMSetup(data, f_stride=a.f_stride, tx_stride=a.tx_stride, dov=dov)\\n        r = run_ssfm(S, devices=a.devices, iters_depth=a.iters // 3, iters_joint=a.iters - a.iters // 3, log=log)\\n        from scipy.interpolate import RegularGridInterpolator\\n        f = RegularGridInterpolator((r['z'], r['x']), r['sos'], bounds_error=False, fill_value=None)\\n        Z, X = np.meshgrid(np.clip(geo.z, r['z'][0], r['z'][-1]), geo.x, indexing='ij')\\n        sos64 = f(np.stack([Z.ravel(), X.ravel()], -1)).reshape(Z.shape).astype(np.float32)\\n    total = time.time() - t0\\n    out = dict(method=a.method, name=a.name, sos64=sos64, time_total_s=total,\\n               time_per_iter_s=r['time_per_iter'], peak_mem_gb=r['peak_mem_gb'], history=r['history'])\\n    if data['has_gt']:\\n        gt = resample_gt(data['C'], data['xC'], data['zC'], geo)\\n        out['gt'] = gt\\n        out['metrics'] = all_metrics(sos64, gt, geo)\\n        log(f\\\"{a.method} {a.name}: RMSE {out['metrics']['RMSE']:.2f}  MAE {out['metrics']['MAE']:.2f}  \\\"\\n            f\\\"({total / 60:.1f} min, {r['peak_mem_gb']:.1f} GB)\\\")\\n    with open(os.path.join(a.out, f'{a.method}_{a.name}.pkl'), 'wb') as f:\\n        pickle.dump(out, f)\\n\\n\\ndef main():\\n    ap = argparse.ArgumentParser(); sub = ap.add_subparsers(dest='cmd', required=True)\\n    g = sub.add_parser('gen'); g.add_argument('--what', required=True); g.add_argument('--n', type=int, required=True)\\n    g.add_argument('--seed', type=int, default=0); g.add_argument('--out', required=True); g.add_argument('--chunk', type=int, default=256)\\n    m = sub.add_parser('merge'); m.add_argument('--inputs', nargs='+'); m.add_argument('--out')\\n    r = sub.add_parser('real'); r.add_argument('--names', nargs='+'); r.add_argument('--root', default='impact_data'); r.add_argument('--out')\\n    e = sub.add_parser('eval'); e.add_argument('--ckpt'); e.add_argument('--data'); e.add_argument('--real'); e.add_argument('--out')\\n    e.add_argument('--n_val', type=int, default=16); e.add_argument('--nus', type=float, nargs='+', default=[0.003, 0.01, 0.03, 0.1])\\n    t = sub.add_parser('thesis'); t.add_argument('--method', required=True); t.add_argument('--name', required=True)\\n    t.add_argument('--root', default='impact_data'); t.add_argument('--out', default='results_thesis')\\n    t.add_argument('--devices', nargs='+', default=['cuda:0']); t.add_argument('--iters', type=int, default=150)\\n    t.add_argument('--f_stride', type=int, default=8); t.add_argument('--tx_stride', type=int, default=1)\\n    t.add_argument('--lam_das', type=float, default=1e-3)\\n    a = ap.parse_args()\\n    dict(gen=cmd_gen, merge=cmd_merge, real=cmd_real, eval=cmd_eval, thesis=cmd_thesis)[a.cmd](a)\\n\\n\\nif __name__ == '__main__':\\n    main()\\n\", \"sosbench/datagen.py\": \"\\\"\\\"\\\"Dataset generation for DenOiS.\\n\\nS : analytic (ray-model) data \\u2014 hi-res operator A_H on 128x128 ground truths,\\n    reconstruction / learning only sees A' on 64x64 (discretisation mismatch).\\nC : wave-simulated data \\u2014 split-step Born simulation -> DAS -> delay tracking\\n    (realistic noise, missing data and imaging-model mismatch).\\nReal : IMPACT channel data -> same DAS + tracking pipeline.\\n\\nEvery sample stores (float16 where large):\\n    x      (64,64)    ground-truth SoS [m/s]          (nan if unknown)\\n    b      (8,64,64)  observed delays b' [ns]\\n    w      (8,64,64)  validity (aperture & correlation), 0/1\\n    rho    (8,64,64)  tracking correlation (S: synthetic)\\n    l1,l2  (64,64)    L1-TV / L2-TV reconstructions from b' [m/s]\\n    Ax     (8,64,64)  model-consistent target A' x [ns]  (nan if unknown)\\n\\\"\\\"\\\"\\nimport os, time\\nimport numpy as np\\n\\nfrom .acq import Geometry, beamform_pw, track_delays, observations_from_fsa, load_impact\\nfrom .raymodel import build_operator, aperture_mask, sos_to_u, u_to_sos, resample_gt\\nfrom .solvers import LinearOp, tv_recon, tv_irls, U_SCALE\\nfrom .phantoms import quasi_random_sos, structured_sos, random_echo, downsample_sos\\nfrom .wavesim import SimConfig, simulate_pw_iq, make_medium\\n\\nRHO_THR = 0.2\\n# Analytical baselines (tuned once on dataset S, never on test data):\\n#   L1-TV : diagonally-preconditioned Chambolle-Pock, relative weight 0.003, 3000 its\\n#   L2-TV : IRLS + CG, weight 3e-5 (normalised units), 8 x 150 its\\nTV_CFG = dict(l1=dict(lam=0.003, iters=3000), l2=dict(lam=3e-5, outer=8, inner=150))\\n\\n\\ndef set_fast_tv(factor=10):\\n    \\\"\\\"\\\"Cheaper solver settings for CPU smoke tests.\\\"\\\"\\\"\\n    TV_CFG['l1']['iters'] = max(50, TV_CFG['l1']['iters'] // factor)\\n    TV_CFG['l2']['inner'] = max(10, TV_CFG['l2']['inner'] // factor)\\n\\n\\nclass Ops:\\n    \\\"\\\"\\\"Bundle of operators on a backend.\\\"\\\"\\\"\\n    def __init__(self, B, geo: Geometry, with_hi=True):\\n        self.B, self.geo = B, geo\\n        t0 = time.time()\\n        self.A = build_operator(geo)                       # A'  (scipy)\\n        self.op = LinearOp(B, self.A, geo.nz, geo.nx)\\n        self.AH = build_operator(geo, upsample=2) if with_hi else None\\n        self.opH = LinearOp(B, self.AH, 2 * geo.nz, 2 * geo.nx) if with_hi else None\\n        self.ap_mask = aperture_mask(geo)\\n        print(f'operators built in {time.time() - t0:.1f}s; s1={self.op.s1:.2f}', flush=True)\\n\\n    def tv(self, b_ns, w, which):\\n        \\\"\\\"\\\"Batched TV reconstruction. b_ns, w: numpy (nb, 8, 64, 64). Returns SoS numpy (nb,64,64).\\\"\\\"\\\"\\n        B, op = self.B, self.op\\n        nb = b_ns.shape[0]\\n        bn = B.asarray(op.b_to_n(b_ns.reshape(nb, -1).astype(np.float32)))\\n        ww = B.asarray(w.reshape(nb, -1).astype(np.float32))\\n        if which == 'l1':\\n            u = tv_recon(op, bn * ww, ww, lam=TV_CFG['l1']['lam'], p=1, iters=TV_CFG['l1']['iters'])\\n        else:\\n            c = TV_CFG['l2']\\n            u = tv_irls(op, bn * ww, ww, lam=c['lam'], p=2, outer=c['outer'], inner=c['inner'])\\n        return u_to_sos(B.to_numpy(u) * U_SCALE, self.geo.c_bf).astype(np.float32)\\n\\n    def Ax(self, sos):\\n        \\\"\\\"\\\"A' x for SoS maps (nb,64,64) -> (nb,8,64,64) [ns].\\\"\\\"\\\"\\n        u = sos_to_u(sos.reshape(sos.shape[0], -1), self.geo.c_bf).T\\n        return (self.A @ u).T.reshape(sos.shape[0], self.geo.npair, self.geo.nz, self.geo.nx).astype(np.float32)\\n\\n\\ndef _save(path, **arrs):\\n    big = {k: (v.astype(np.float16) if v.dtype == np.float32 and v.ndim == 4 else v) for k, v in arrs.items()}\\n    np.savez(path, **big)\\n\\n\\n# ---------------------------------------------------------------------------- S\\ndef gen_S(ops: Ops, n, path, seed=0, chunk=256, layered_frac=0.3):\\n    geo = ops.geo\\n    rng = np.random.default_rng(seed)\\n    X, Bo, W, L1, L2, AX = [], [], [], [], [], []\\n    for c0 in range(0, n, chunk):\\n        m = min(chunk, n - c0)\\n        hi = np.stack([quasi_random_sos(rng, 2 * geo.nz, 2 * geo.nx, geo.dz / 2, geo.dx / 2, layered_frac)\\n                       for _ in range(m)])\\n        lo = np.stack([downsample_sos(h) for h in hi])\\n        uH = sos_to_u(hi.reshape(m, -1), geo.c_bf).T\\n        b = (ops.AH @ uH).T.reshape(m, geo.npair, geo.nz, geo.nx).astype(np.float32)\\n        # measurement degradations: additive noise, random low-SNR holes, outliers\\n        sig = rng.uniform(0.5, 4.0, (m, 1, 1, 1))\\n        b = b + sig * rng.standard_normal(b.shape).astype(np.float32)\\n        holes = np.stack([_random_holes(rng, geo) for _ in range(m)])\\n        w = (ops.ap_mask[None] & ~holes).astype(np.float32)\\n        out = rng.random(b.shape) < 0.01\\n        b = np.where(out, rng.uniform(-60, 60, b.shape), b).astype(np.float32)\\n        L1.append(ops.tv(b, w, 'l1')); L2.append(ops.tv(b, w, 'l2'))\\n        X.append(lo); Bo.append(b * w); W.append(w); AX.append(ops.Ax(lo))\\n        print(f'S {c0 + m}/{n}', flush=True)\\n    _save(path, x=np.concatenate(X), b=np.concatenate(Bo), w=np.concatenate(W),\\n          l1=np.concatenate(L1), l2=np.concatenate(L2), Ax=np.concatenate(AX))\\n\\n\\ndef _random_holes(rng, geo, p=0.6):\\n    from scipy import ndimage\\n    h = np.zeros((geo.npair, geo.nz, geo.nx), bool)\\n    if rng.random() < p:\\n        n = ndimage.gaussian_filter(rng.standard_normal((geo.npair, geo.nz, geo.nx)), (0, 4, 4))\\n        h = n > np.quantile(n, 1 - rng.uniform(0.05, 0.35))\\n    return h\\n\\n\\n# ---------------------------------------------------------------------------- C\\ndef simulate_case(B, ops: Ops, cfg: SimConfig, rng, sos_hi):\\n    \\\"\\\"\\\"Wave-simulate one medium; return observations (b', rho, w) and B-mode.\\\"\\\"\\\"\\n    geo = ops.geo\\n    ext = (0.0, geo.nz * geo.dz, geo.x[0] - geo.dx / 2, geo.x[-1] + geo.dx / 2)\\n    echo = random_echo(rng, sos_hi)\\n    sos_s, refl = make_medium(rng, cfg, sos_hi, ext, echo)\\n    iq, t_out = simulate_pw_iq(B, cfg, sos_s, refl)\\n    imgs = beamform_pw(B, iq, t_out, geo)\\n    d, r = track_delays(B, imgs, geo)\\n    d, r = B.to_numpy(d).astype(np.float32), B.to_numpy(r).astype(np.float32)\\n    w = (ops.ap_mask & (r >= RHO_THR)).astype(np.float32)\\n    comp = B.to_numpy(B.abs(B.sum(imgs, 0)))\\n    return d, r, w, comp\\n\\n\\ndef gen_C(B, ops: Ops, n, path, seed=1, kind='quasi', layered_frac=0.3, log_every=10):\\n    geo = ops.geo\\n    cfg = SimConfig(geo, fc=geo.fc)\\n    rng = np.random.default_rng(seed)\\n    X, Bo, W, R = [], [], [], []\\n    t0 = time.time()\\n    for i in range(n):\\n        if kind == 'quasi':\\n            hi = quasi_random_sos(rng, 2 * geo.nz, 2 * geo.nx, geo.dz / 2, geo.dx / 2, layered_frac)\\n        else:\\n            hi = structured_sos(rng, 2 * geo.nz, 2 * geo.nx, geo.dz / 2, geo.dx / 2)\\n        d, r, w, _ = simulate_case(B, ops, cfg, rng, hi)\\n        X.append(downsample_sos(hi)); Bo.append(d * w); W.append(w); R.append(r)\\n        if (i + 1) % log_every == 0:\\n            el = time.time() - t0\\n            print(f'C[{kind}] {i + 1}/{n}  {el / (i + 1):.2f}s/case', flush=True)\\n    X = np.stack(X); Bo = np.stack(Bo); W = np.stack(W); R = np.stack(R)\\n    L1 = np.concatenate([ops.tv(Bo[i:i + 64], W[i:i + 64], 'l1') for i in range(0, n, 64)])\\n    L2 = np.concatenate([ops.tv(Bo[i:i + 64], W[i:i + 64], 'l2') for i in range(0, n, 64)])\\n    _save(path, x=X, b=Bo, w=W, rho=R, l1=L1, l2=L2, Ax=ops.Ax(X))\\n\\n\\n# ---------------------------------------------------------------------------- real\\ndef real_case(B, ops: Ops, name, root='impact_data'):\\n    geo = ops.geo\\n    data = load_impact(name, root)\\n    if abs(data['fc'] - geo.fc) > 1:\\n        print(f'note: {name} fc={data[\\\"fc\\\"] / 1e6} MHz differs from the training fc={geo.fc / 1e6} MHz')\\n    geo_r = Geometry(**{**_geo_kwargs(geo), 'elx': data['elx'], 'fc': data['fc']})\\n    d, r, bm = observations_from_fsa(data, geo_r, B)\\n    d = d.astype(np.float32); r = r.astype(np.float32)\\n    w = (ops.ap_mask & (r >= RHO_THR)).astype(np.float32)\\n    x = resample_gt(data['C'], data['xC'], data['zC'], geo_r) if data['has_gt'] else np.full((geo.nz, geo.nx), np.nan, np.float32)\\n    out = dict(name=name, x=x, b=d * w, w=w, rho=r, bmode=bm, geo=geo_r)\\n    out['l1'] = ops.tv(out['b'][None], w[None], 'l1')[0]\\n    out['l2'] = ops.tv(out['b'][None], w[None], 'l2')[0]\\n    return out\\n\\n\\ndef _geo_kwargs(geo):\\n    keys = ['fc', 'c_bf', 'tx_mode', 'n_tx', 'angles_deg', 'dw_subap', 'dw_zv', 'nz', 'nx', 'dz', 'dx',\\n            'bf_sub_z', 'bf_sub_x', 'fnum_rx', 'zmin_valid', 'track_win_z', 'track_win_x']\\n    return {k: getattr(geo, k) for k in keys}\\n\", \"sosbench/denois.py\": \"\\\"\\\"\\\"DenOiS inference: observation refinement (M_U / M_D) + diffusion plug-and-play\\nreconstruction (R_D) with conjugate-gradient data consistency, plus the baselines\\n(L1-TV, L2-TV, direct Unet [Chen&Han], DOLCE, Unet(M_U)) evaluated on the same inputs.\\n\\\"\\\"\\\"\\nimport os, time\\nimport numpy as np\\nimport torch\\n\\nfrom .backend import get_backend\\nfrom .datagen import Ops\\nfrom .nets import sos_norm, sos_denorm, B_SCALE\\nfrom .raymodel import sos_to_u, u_to_sos\\nfrom .solvers import dc_cg, U_SCALE\\nfrom .train import load_model, refiner_inputs\\nfrom .metrics import all_metrics\\n\\n\\nSIM_PNP = dict(t0=15, K=5)       # paper: in-silico T0=15, K=5\\nREAL_PNP = dict(t0=50, K=10)     # paper: real data  T0=50, K=10\\n\\n\\nclass DenoisRunner:\\n    def __init__(self, ckpt_dir, geo, device='cuda', nu=0.03, cg_iters=5):\\n        self.dev = device\\n        self.B = get_backend('torch', device)\\n        self.geo = geo\\n        self.ops = Ops(self.B, geo, with_hi=False)\\n        self.models = {}\\n        for f in sorted(os.listdir(ckpt_dir)):\\n            if f.endswith('.pt') and not f.endswith('_S.pt'):\\n                self.models[f[:-3]] = load_model(os.path.join(ckpt_dir, f), device)\\n        print('loaded models:', sorted(self.models))\\n        self.nu, self.cg_iters = nu, cg_iters\\n        Z = np.meshgrid(geo.z, geo.x, indexing='ij')[0]\\n        self.depth_ok = np.broadcast_to((Z >= geo.zmin_valid)[None], (geo.npair, geo.nz, geo.nx)).astype(np.float32)\\n\\n    # ------------------------------------------------------------- observation domain\\n    @torch.no_grad()\\n    def refine(self, b, w, xprime, name, seed=0):\\n        \\\"\\\"\\\"b, w: (n,8,64,64); xprime: (n,64,64) SoS.  name e.g. 'mu_bPA' / 'md_bP'.\\n        Returns refined delays (n,8,64,64) [ns] and weights (inpainted -> all valid).\\\"\\\"\\\"\\n        variant = name.split('_')[1]\\n        X = torch.from_numpy(refiner_inputs(b, w, xprime, variant, self.geo)).to(self.dev)\\n        model, diff = self.models[name]\\n        outs = []\\n        for s in range(0, len(X), 128):\\n            c = X[s:s + 128]\\n            if diff is None:\\n                outs.append(model(c))\\n            else:\\n                outs.append(diff.ddpm(model, c, (len(c), 1, *c.shape[2:]), seed=seed + s))\\n        y = torch.cat(outs).cpu().numpy()[:, 0] * B_SCALE\\n        n = b.shape[0]\\n        wr = np.broadcast_to(self.depth_ok[None], b.shape).astype(np.float32)\\n        return y.reshape(b.shape).astype(np.float32), wr\\n\\n    def tv(self, b, w):\\n        return self.ops.tv(b, w, 'l1'), self.ops.tv(b, w, 'l2')\\n\\n    # ------------------------------------------------------------- solution domain\\n    def _dc_fn(self, b, w, nu=None):\\n        B, op = self.B, self.ops.op\\n        n = b.shape[0]\\n        bn = B.asarray(op.b_to_n(b.reshape(n, -1).astype(np.float32)))\\n        ww = B.asarray(w.reshape(n, -1).astype(np.float32))\\n        nu = self.nu if nu is None else nu\\n        cbf = self.geo.c_bf\\n\\n        def dc(x0):\\n            c = sos_denorm(x0[:, 0]).clamp(1300, 1750)\\n            u = (1.0 / c - 1.0 / cbf) * 1e6 / U_SCALE\\n            u = dc_cg(op, bn * ww, ww, u, nu, self.cg_iters)\\n            c2 = 1.0 / (1.0 / cbf + u * U_SCALE * 1e-6)\\n            return sos_norm(c2)[:, None]\\n        return dc\\n\\n    @torch.no_grad()\\n    def rd(self, b, w, l1, l2, real=False, nu=None, seed=0, model='rd', guidance=0.0):\\n        \\\"\\\"\\\"DenOiS reconstruction module R_D: start from the L1-TV proposal + noise at T0,\\n        DDIM denoising conditioned on {L1-TV, L2-TV}, CG data consistency every K steps.\\\"\\\"\\\"\\n        m, diff = self.models[model]\\n        p = REAL_PNP if real else SIM_PNP\\n        cond = torch.from_numpy(np.stack([sos_norm(l1), sos_norm(l2)], 1).astype(np.float32)).to(self.dev)\\n        x_init = cond[:, :1].clone()\\n        x0 = diff.ddim(m, cond, x_init=x_init, t0=p['t0'], dc=self._dc_fn(b, w, nu), K=p['K'],\\n                       guidance=guidance, seed=seed)\\n        return sos_denorm(x0[:, 0]).cpu().numpy()\\n\\n    @torch.no_grad()\\n    def dolce(self, b, w, l2, nu=None, seed=0):\\n        \\\"\\\"\\\"DOLCE: conditioned on L2-TV only, from pure noise, DC after every step.\\\"\\\"\\\"\\n        m, diff = self.models['dolce']\\n        cond = torch.from_numpy(sos_norm(l2)[:, None].astype(np.float32)).to(self.dev)\\n        x0 = diff.ddpm(m, cond, cond.shape, dc=self._dc_fn(b, w, nu), K=1, seed=seed)\\n        return sos_denorm(x0[:, 0]).cpu().numpy()\\n\\n    @torch.no_grad()\\n    def unetR(self, l1, l2):\\n        m, _ = self.models['unetR']\\n        c = torch.from_numpy(np.stack([sos_norm(l1), sos_norm(l2)], 1).astype(np.float32)).to(self.dev)\\n        return sos_denorm(m(c)[:, 0]).cpu().numpy()\\n\\n    @torch.no_grad()\\n    def direct(self, b, w):\\n        m, _ = self.models['direct']\\n        c = torch.from_numpy(np.concatenate([b / B_SCALE, w], 1).astype(np.float32)).to(self.dev)\\n        return sos_denorm(m(c)[:, 0]).cpu().numpy()\\n\\n    # ------------------------------------------------------------- full grid of methods\\n    def run_grid(self, cases, real=False, refiners=('mu_b', 'mu_bP', 'mu_bPA', 'md_bPA'),\\n                 recons=('L2-TV', 'L1-TV', 'Unet[5]', 'Dolce', 'Unet(MU)', 'RD'), n_outer=1, log=print):\\n        \\\"\\\"\\\"cases: dict with stacked arrays b, w, l1, l2 (n,...).  Returns\\n        {input_name: {recon_name: (n,64,64) SoS}} and the refined observations.\\\"\\\"\\\"\\n        b, w, l1, l2 = cases['b'], cases['w'], cases['l1'], cases['l2']\\n        out, obs = {}, {}\\n        inputs = [(\\\"b'\\\", b, w, l1, l2)]\\n        for r in refiners:\\n            if r not in self.models:\\n                continue\\n            t0 = time.time()\\n            xprime = l1\\n            for it in range(n_outer):\\n                br, wr = self.refine(b, w, xprime, r)\\n                r1, r2 = self.tv(br, wr)\\n                if n_outer > 1 and 'rd' in self.models:\\n                    xprime = self.rd(br, wr, r1, r2, real=real)\\n            name = {'mu': 'MU', 'md': 'MD'}[r[:2]] + '(' + {'b': \\\"b'\\\", 'bP': \\\"b',P\\\", 'bPA': \\\"b',P,A'x'\\\"}[r.split('_')[1]] + ')'\\n            inputs.append((name, br, wr, r1, r2)); obs[name] = br\\n            log(f'  refined with {name} in {time.time() - t0:.1f}s')\\n        for name, bb, ww, r1, r2 in inputs:\\n            res = {}\\n            for rc in recons:\\n                t0 = time.time()\\n                if rc == 'L2-TV': res[rc] = r2\\n                elif rc == 'L1-TV': res[rc] = r1\\n                elif rc == 'Unet[5]' and 'direct' in self.models and name == \\\"b'\\\": res[rc] = self.direct(bb, ww)\\n                elif rc == 'Dolce' and 'dolce' in self.models: res[rc] = self.dolce(bb, ww, r2)\\n                elif rc == 'Unet(MU)' and 'unetR' in self.models: res[rc] = self.unetR(r1, r2)\\n                elif rc == 'RD' and 'rd' in self.models: res[rc] = self.rd(bb, ww, r1, r2, real=real)\\n            out[name] = res\\n            log(f'  {name}: ' + ', '.join(res))\\n        return out, obs\\n\\n\\ndef score_grid(grid, gt, geo):\\n    \\\"\\\"\\\"Mean metrics per (input, recon) over cases with ground truth.\\\"\\\"\\\"\\n    table = {}\\n    for inp, rs in grid.items():\\n        for rc, X in rs.items():\\n            ms = [all_metrics(X[i], gt[i], geo) for i in range(len(gt))]\\n            keys = set.intersection(*[set(m) for m in ms])\\n            table[(inp, rc)] = {k: (float(np.mean([m[k] for m in ms])), float(np.std([m[k] for m in ms]))) for k in keys}\\n    return table\\n\\n\\ndef print_table(table, metric='RMSE', second='ACE'):\\n    inps = list(dict.fromkeys(k[0] for k in table)); rcs = list(dict.fromkeys(k[1] for k in table))\\n    hdr = f\\\"{'Input':<16}\\\" + ''.join(f'{r:>18}' for r in rcs)\\n    lines = [hdr, '-' * len(hdr)]\\n    for i in inps:\\n        row = f'{i:<16}'\\n        for r in rcs:\\n            v = table.get((i, r))\\n            if v is None: row += f\\\"{'':>18}\\\"\\n            else:\\n                a = v[metric][0]; s = f'{a:.2f}'\\n                if second in v: s += f' ({v[second][0]:.2f})'\\n                row += f'{s:>18}'\\n        lines.append(row)\\n    return '\\\\n'.join(lines)\\n\", \"sosbench/jobs.py\": \"\\\"\\\"\\\"Run shell command queues on separate GPUs from a notebook and follow their logs.\\\"\\\"\\\"\\nimport os, subprocess, sys, time\\n\\n\\ndef start_queue(cmds, gpu, log_path, workdir='.'):\\n    env = dict(os.environ, CUDA_VISIBLE_DEVICES=str(gpu), PYTHONUNBUFFERED='1',\\n               PYTHONPATH=os.path.abspath(workdir) + os.pathsep + os.environ.get('PYTHONPATH', ''))\\n    script = ' && '.join(f'echo \\\">>> {c}\\\" && {c}' for c in cmds)\\n    f = open(log_path, 'w')\\n    p = subprocess.Popen(['bash', '-c', script], env=env, stdout=f, stderr=subprocess.STDOUT, cwd=workdir)\\n    p._log = log_path\\n    return p\\n\\n\\ndef _tail(path, n=3):\\n    try:\\n        with open(path) as f:\\n            return [l.rstrip() for l in f.readlines()[-n:]]\\n    except FileNotFoundError:\\n        return []\\n\\n\\ndef wait_all(procs, every=60, tail=2):\\n    \\\"\\\"\\\"Block until every queue finishes, printing the last log lines periodically.\\\"\\\"\\\"\\n    t0 = time.time()\\n    while True:\\n        alive = [p for p in procs if p.poll() is None]\\n        print(f'--- {time.strftime(\\\"%H:%M:%S\\\")}  elapsed {(time.time() - t0) / 60:.1f} min  running {len(alive)}/{len(procs)}')\\n        for p in procs:\\n            for l in _tail(p._log, tail): print(f'   [{os.path.basename(p._log)}] {l}')\\n        sys.stdout.flush()\\n        if not alive: break\\n        time.sleep(every)\\n    bad = [p._log for p in procs if p.returncode != 0]\\n    if bad:\\n        for b in bad:\\n            print(f'===== {b} (last 40 lines) =====')\\n            print('\\\\n'.join(_tail(b, 40)))\\n        raise RuntimeError(f'queue(s) failed: {bad}')\\n    print(f'all queues finished in {(time.time() - t0) / 60:.1f} min')\\n\", \"sosbench/metrics.py\": \"\\\"\\\"\\\"Evaluation metrics (DenOiS paper + thesis).\\\"\\\"\\\"\\nimport numpy as np\\n\\n\\ndef roi_mask(geo, x_lim=(-12e-3, 12e-3), z_lim=(0, 38.4e-3)):\\n    Z, X = np.meshgrid(geo.z, geo.x, indexing='ij')\\n    Xr = X - geo.xc\\n    return (Xr >= x_lim[0]) & (Xr <= x_lim[1]) & (Z >= z_lim[0]) & (Z <= z_lim[1])\\n\\n\\ndef rmse(a, b, m=None):\\n    d = (a - b) if m is None else (a - b)[m]\\n    return float(np.sqrt(np.mean(d ** 2)))\\n\\n\\ndef mae(a, b, m=None):\\n    d = (a - b) if m is None else (a - b)[m]\\n    return float(np.mean(np.abs(d)))\\n\\n\\ndef inclusion_masks(gt, geo, thr=8.0, margin_mm=5.0):\\n    \\\"\\\"\\\"Inclusion = connected region differing from the background median by > thr m/s;\\n    'background' = a margin ring (default 0.5 cm, as in DenOiS) around it.\\\"\\\"\\\"\\n    from scipy import ndimage\\n    bg = np.median(gt)\\n    inc = np.abs(gt - bg) > thr\\n    if inc.sum() == 0:\\n        return None, None\\n    px = max(1, int(round(margin_mm * 1e-3 / min(geo.dz, geo.dx))))\\n    dil = ndimage.binary_dilation(inc, iterations=px)\\n    ring = dil & ~inc\\n    return inc, ring\\n\\n\\ndef contrast(img, inc, ring):\\n    return float(np.median(img[inc]) - np.median(img[ring]))\\n\\n\\ndef ace(rec, gt, inc, ring):\\n    return abs(contrast(rec, inc, ring) - contrast(gt, inc, ring))\\n\\n\\ndef gcnr(img, inc, ring, bins=100):\\n    lo, hi = np.percentile(np.concatenate([img[inc], img[ring]]), [0, 100])\\n    h1, e = np.histogram(img[inc], bins=bins, range=(lo, hi), density=True)\\n    h2, _ = np.histogram(img[ring], bins=bins, range=(lo, hi), density=True)\\n    return float(1 - np.sum(np.minimum(h1, h2)) * (e[1] - e[0]))\\n\\n\\ndef all_metrics(rec, gt, geo, roi=None):\\n    roi = roi_mask(geo) if roi is None else roi\\n    out = dict(RMSE=rmse(rec, gt, roi), MAE=mae(rec, gt, roi))\\n    inc, ring = inclusion_masks(gt, geo)\\n    if inc is not None and inc.sum() > 4 and ring.sum() > 4:\\n        out.update(ACE=ace(rec, gt, inc, ring), dC=contrast(rec, inc, ring), gCNR=gcnr(rec, inc, ring))\\n    return out\\n\", \"sosbench/nets.py\": \"\\\"\\\"\\\"Networks and diffusion machinery (PyTorch).\\n\\nUNet       : ADM-style U-Net (Dhariwal & Nichol) \\u2014 4 resolution levels with channel\\n             multipliers (1,2,2,2), base width 64, optional timestep embedding.\\nDiffusion  : linear-schedule DDPM (T=200), eps-prediction, classifier-free-guidance\\n             training (condition dropout 0.2), DDIM / DDPM samplers with an optional\\n             plug-and-play data-consistency hook every K steps.\\n\\\"\\\"\\\"\\nimport math\\nimport torch\\nimport torch.nn as nn\\nimport torch.nn.functional as F\\n\\n# --------------------------------------------------------------------------- normalisation\\nSOS_MID, SOS_HALF = 1525.0, 125.0          # [1400,1650] -> [-1,1]\\nB_SCALE = 20.0                             # ns\\n\\n\\ndef sos_norm(c):   return (c - SOS_MID) / SOS_HALF\\ndef sos_denorm(x): return x * SOS_HALF + SOS_MID\\n\\n\\n# --------------------------------------------------------------------------- U-Net\\ndef timestep_embedding(t, dim):\\n    half = dim // 2\\n    freqs = torch.exp(-math.log(10000) * torch.arange(half, device=t.device, dtype=torch.float32) / half)\\n    args = t.float()[:, None] * freqs[None]\\n    return torch.cat([torch.cos(args), torch.sin(args)], dim=-1)\\n\\n\\ndef _gn(ch):\\n    return nn.GroupNorm(min(32, ch // 4), ch)\\n\\n\\nclass ResBlock(nn.Module):\\n    def __init__(self, cin, cout, tdim, dropout):\\n        super().__init__()\\n        self.n1 = _gn(cin); self.c1 = nn.Conv2d(cin, cout, 3, padding=1)\\n        self.t = nn.Linear(tdim, cout) if tdim else None\\n        self.n2 = _gn(cout); self.drop = nn.Dropout(dropout); self.c2 = nn.Conv2d(cout, cout, 3, padding=1)\\n        nn.init.zeros_(self.c2.weight); nn.init.zeros_(self.c2.bias)\\n        self.skip = nn.Conv2d(cin, cout, 1) if cin != cout else nn.Identity()\\n\\n    def forward(self, x, temb):\\n        h = self.c1(F.silu(self.n1(x)))\\n        if self.t is not None:\\n            h = h + self.t(F.silu(temb))[:, :, None, None]\\n        h = self.c2(self.drop(F.silu(self.n2(h))))\\n        return h + self.skip(x)\\n\\n\\nclass Attn(nn.Module):\\n    def __init__(self, ch, heads=4):\\n        super().__init__()\\n        self.n = _gn(ch); self.qkv = nn.Conv2d(ch, 3 * ch, 1); self.o = nn.Conv2d(ch, ch, 1); self.h = heads\\n        nn.init.zeros_(self.o.weight); nn.init.zeros_(self.o.bias)\\n\\n    def forward(self, x, temb=None):\\n        b, c, hh, ww = x.shape\\n        q, k, v = self.qkv(self.n(x)).reshape(b, 3, self.h, c // self.h, hh * ww).unbind(1)\\n        a = F.scaled_dot_product_attention(q.transpose(-1, -2), k.transpose(-1, -2), v.transpose(-1, -2))\\n        return x + self.o(a.transpose(-1, -2).reshape(b, c, hh, ww))\\n\\n\\nclass UNet(nn.Module):\\n    def __init__(self, in_ch, out_ch, base=64, mults=(1, 2, 2, 2), nres=2, attn_levels=(3,),\\n                 use_t=True, dropout=0.1):\\n        super().__init__()\\n        self.use_t = use_t\\n        tdim = 4 * base if use_t else 0\\n        if use_t:\\n            self.temb = nn.Sequential(nn.Linear(base, tdim), nn.SiLU(), nn.Linear(tdim, tdim))\\n        self.base = base\\n        self.inp = nn.Conv2d(in_ch, base, 3, padding=1)\\n        self.down = nn.ModuleList(); chans = [base]; ch = base\\n        for li, m in enumerate(mults):\\n            for _ in range(nres):\\n                blk = nn.ModuleList([ResBlock(ch, base * m, tdim, dropout)]); ch = base * m\\n                if li in attn_levels: blk.append(Attn(ch))\\n                self.down.append(blk); chans.append(ch)\\n            if li < len(mults) - 1:\\n                self.down.append(nn.ModuleList([nn.Conv2d(ch, ch, 3, stride=2, padding=1)])); chans.append(ch)\\n        self.mid = nn.ModuleList([ResBlock(ch, ch, tdim, dropout), Attn(ch), ResBlock(ch, ch, tdim, dropout)])\\n        self.up = nn.ModuleList()\\n        for li, m in reversed(list(enumerate(mults))):\\n            for _ in range(nres + 1):\\n                blk = nn.ModuleList([ResBlock(ch + chans.pop(), base * m, tdim, dropout)]); ch = base * m\\n                if li in attn_levels: blk.append(Attn(ch))\\n                self.up.append(blk)\\n            if li > 0:\\n                self.up.append(nn.ModuleList([nn.Upsample(scale_factor=2, mode='nearest'), nn.Conv2d(ch, ch, 3, padding=1)]))\\n        self.out = nn.Sequential(_gn(ch), nn.SiLU(), nn.Conv2d(ch, out_ch, 3, padding=1))\\n\\n    def forward(self, x, t=None):\\n        temb = self.temb(timestep_embedding(t, self.base)) if self.use_t else None\\n        h = self.inp(x); hs = [h]\\n        for blk in self.down:\\n            if isinstance(blk[0], ResBlock):\\n                h = blk[0](h, temb)\\n                for extra in blk[1:]: h = extra(h)\\n            else:\\n                h = blk[0](h)\\n            hs.append(h)\\n        h = self.mid[0](h, temb); h = self.mid[1](h); h = self.mid[2](h, temb)\\n        for blk in self.up:\\n            if isinstance(blk[0], ResBlock):\\n                h = blk[0](torch.cat([h, hs.pop()], 1), temb)\\n                for extra in blk[1:]: h = extra(h)\\n            else:\\n                h = blk[1](blk[0](h))\\n        return self.out(h)\\n\\n\\n# --------------------------------------------------------------------------- diffusion\\nclass Diffusion:\\n    \\\"\\\"\\\"x-space: (nb, 1, H, W).  Model input = cat[x_t, cond * keep, keep-flag].\\\"\\\"\\\"\\n    def __init__(self, T=200, device='cpu'):\\n        self.T = T\\n        scale = 1000.0 / T                                  # keep the classic 1e-4..0.02 @ T=1000 range\\n        betas = torch.linspace(1e-4 * scale, 0.02 * scale, T, dtype=torch.float64)\\n        ac = torch.cumprod(1 - betas, 0)\\n        self.betas = betas.float().to(device)\\n        self.ac = ac.float().to(device)                    # alpha_bar_t, t = 0..T-1\\n        self.device = device\\n\\n    def to(self, device):\\n        self.betas = self.betas.to(device); self.ac = self.ac.to(device); self.device = device\\n        return self\\n\\n    @staticmethod\\n    def model_in(x_t, cond, keep):\\n        if cond is None:\\n            return x_t\\n        return torch.cat([x_t, cond * keep[:, None, None, None], keep[:, None, None, None].expand_as(x_t)], 1)\\n\\n    def loss(self, model, x0, cond, p_uncond=0.2):\\n        nb = x0.shape[0]\\n        t = torch.randint(0, self.T, (nb,), device=x0.device)\\n        noise = torch.randn_like(x0)\\n        a = self.ac[t][:, None, None, None]\\n        x_t = a.sqrt() * x0 + (1 - a).sqrt() * noise\\n        keep = (torch.rand(nb, device=x0.device) >= p_uncond).float() if cond is not None else None\\n        eps = model(self.model_in(x_t, cond, keep), t)\\n        return F.mse_loss(eps, noise)\\n\\n    def eps(self, model, x_t, t_int, cond, guidance=0.0):\\n        nb = x_t.shape[0]\\n        t = torch.full((nb,), t_int, device=x_t.device, dtype=torch.long)\\n        if cond is None:\\n            return model(x_t, t)\\n        e_c = model(self.model_in(x_t, cond, torch.ones(nb, device=x_t.device)), t)\\n        if guidance == 0:\\n            return e_c\\n        e_u = model(self.model_in(x_t, cond, torch.zeros(nb, device=x_t.device)), t)\\n        return (1 + guidance) * e_c - guidance * e_u\\n\\n    @torch.no_grad()\\n    def ddim(self, model, cond, x_init=None, t0=None, shape=None, dc=None, K=5, guidance=0.0, seed=None):\\n        \\\"\\\"\\\"DDIM (eta=0) from noise level t0 (x_init noised to t0, or pure noise if None).\\n        dc(x0_hat) -> x0_hat' is applied every K denoising steps and at the end.\\\"\\\"\\\"\\n        g = torch.Generator(device=self.device).manual_seed(seed) if seed is not None else None\\n        t0 = self.T - 1 if t0 is None else min(t0, self.T - 1)\\n        if x_init is None:\\n            x = torch.randn(shape, device=self.device, generator=g)\\n        else:\\n            a = self.ac[t0]\\n            x = a.sqrt() * x_init + (1 - a).sqrt() * torch.randn(x_init.shape, device=self.device, generator=g)\\n        x0 = x\\n        for i, t in enumerate(range(t0, -1, -1)):\\n            a = self.ac[t]\\n            e = self.eps(model, x, t, cond, guidance)\\n            x0 = ((x - (1 - a).sqrt() * e) / a.sqrt()).clamp(-1.5, 1.5)\\n            if dc is not None and ((i + 1) % K == 0 or t == 0):\\n                x0 = dc(x0)\\n                e = (x - a.sqrt() * x0) / (1 - a).sqrt().clamp_min(1e-8)\\n            if t > 0:\\n                ap = self.ac[t - 1]\\n                x = ap.sqrt() * x0 + (1 - ap).sqrt() * e\\n        return x0\\n\\n    @torch.no_grad()\\n    def ddpm(self, model, cond, shape, dc=None, K=1, guidance=0.0, seed=None):\\n        \\\"\\\"\\\"Ancestral DDPM sampling from pure noise (used for the diffusion refiner M_D\\n        and for the DOLCE baseline with dc every step).\\\"\\\"\\\"\\n        g = torch.Generator(device=self.device).manual_seed(seed) if seed is not None else None\\n        x = torch.randn(shape, device=self.device, generator=g)\\n        x0 = x\\n        for i, t in enumerate(range(self.T - 1, -1, -1)):\\n            a = self.ac[t]; beta = self.betas[t]\\n            e = self.eps(model, x, t, cond, guidance)\\n            x0 = ((x - (1 - a).sqrt() * e) / a.sqrt()).clamp(-1.5, 1.5)\\n            if dc is not None and ((i + 1) % K == 0 or t == 0):\\n                x0 = dc(x0)\\n            if t > 0:\\n                ap = self.ac[t - 1]\\n                mean = (ap.sqrt() * beta / (1 - a)) * x0 + ((1 - beta).sqrt() * (1 - ap) / (1 - a)) * x\\n                var = beta * (1 - ap) / (1 - a)\\n                x = mean + var.sqrt() * torch.randn(x.shape, device=self.device, generator=g)\\n        return x0\\n\\n\\ndef count_params(m):\\n    return sum(p.numel() for p in m.parameters()) / 1e6\\n\", \"sosbench/phantoms.py\": \"\\\"\\\"\\\"Random speed-of-sound media for training/testing (DenOiS datasets S and C).\\n\\nquasi_random_sos : \\\"quasi-random shapes and SoS distributions in [1400,1650] m/s,\\n                    some homogeneous, 50% blurred with random Gaussian kernels\\\" (S, C1)\\nstructured_sos   : well-structured circular / rectangular inclusions (C2 test set)\\n\\\"\\\"\\\"\\nimport numpy as np\\nfrom scipy import ndimage\\n\\nC_MIN, C_MAX = 1400.0, 1650.0\\n\\n\\ndef _smooth_noise(rng, shape, sigma):\\n    n = ndimage.gaussian_filter(rng.standard_normal(shape), sigma)\\n    return n / (n.std() + 1e-9)\\n\\n\\ndef _blob_mask(rng, Z, X, zc, xc, rz, rx, rot, kind):\\n    zr = (Z - zc) * np.cos(rot) + (X - xc) * np.sin(rot)\\n    xr = -(Z - zc) * np.sin(rot) + (X - xc) * np.cos(rot)\\n    if kind == 'ellipse':\\n        return (zr / rz) ** 2 + (xr / rx) ** 2 <= 1\\n    if kind == 'rect':\\n        return (np.abs(zr) <= rz) & (np.abs(xr) <= rx)\\n    # irregular blob: ellipse with a smooth random radius perturbation\\n    th = np.arctan2(zr / rz, xr / rx)\\n    r = np.sqrt((zr / rz) ** 2 + (xr / rx) ** 2)\\n    k = rng.integers(2, 6)\\n    pert = 1 + sum(rng.uniform(0, 0.25) * np.cos(j * th + rng.uniform(0, 2 * np.pi)) for j in range(1, k + 1))\\n    return r <= pert\\n\\n\\ndef quasi_random_sos(rng, nz, nx, dz, dx, layered_frac=0.3):\\n    \\\"\\\"\\\"SoS map (nz, nx) [m/s] on a grid with pixel size (dz, dx) [m].\\\"\\\"\\\"\\n    Z, X = np.meshgrid((np.arange(nz) + 0.5) * dz, (np.arange(nx) - (nx - 1) / 2) * dx, indexing='ij')\\n    H, W = nz * dz, nx * dx\\n    c = np.full((nz, nx), rng.uniform(1430, 1620))\\n    if rng.random() < 0.5:                               # smooth background variation\\n        c += rng.uniform(0, 25) * _smooth_noise(rng, (nz, nx), rng.uniform(6, 20) * nz / 64)\\n    if rng.random() < layered_frac:                      # tissue-like layers from the skin down\\n        ztop = 0.0\\n        for _ in range(rng.integers(1, 4)):\\n            th = rng.uniform(2e-3, 12e-3)\\n            amp = rng.uniform(0, 2e-3); per = rng.uniform(8e-3, 40e-3); ph = rng.uniform(0, 2 * np.pi)\\n            zb = ztop + th + amp * np.sin(2 * np.pi * X / per + ph)\\n            c = np.where((Z >= ztop) & (Z < zb), rng.uniform(1420, 1620), c)\\n            ztop = ztop + th\\n    n_inc = rng.choice([0, 1, 2, 3, 4], p=[0.15, 0.35, 0.25, 0.15, 0.10])\\n    for _ in range(n_inc):\\n        kind = rng.choice(['ellipse', 'blob', 'rect'], p=[0.5, 0.35, 0.15])\\n        rz = rng.uniform(2e-3, 10e-3); rx = rz * rng.uniform(0.5, 2.0)\\n        m = _blob_mask(rng, Z, X, rng.uniform(3e-3, H - 2e-3), rng.uniform(-W / 2, W / 2), rz, rx,\\n                       rng.uniform(0, np.pi), kind)\\n        c = np.where(m, rng.uniform(C_MIN, C_MAX), c)\\n    if rng.random() < 0.5:\\n        c = ndimage.gaussian_filter(c, rng.uniform(0.5, 3.0) * nz / 64)\\n    return np.clip(c, C_MIN, C_MAX).astype(np.float32)\\n\\n\\ndef structured_sos(rng, nz, nx, dz, dx):\\n    \\\"\\\"\\\"Single circular or rectangular inclusion, positive or negative contrast (C2).\\\"\\\"\\\"\\n    Z, X = np.meshgrid((np.arange(nz) + 0.5) * dz, (np.arange(nx) - (nx - 1) / 2) * dx, indexing='ij')\\n    H, W = nz * dz, nx * dx\\n    bg = rng.uniform(1470, 1580)\\n    dc = rng.choice([-1, 1]) * rng.uniform(20, 70)\\n    kind = rng.choice(['ellipse', 'rect'])\\n    r = rng.uniform(3e-3, 7e-3)\\n    m = _blob_mask(rng, Z, X, rng.uniform(0.35 * H, 0.75 * H), rng.uniform(-W / 4, W / 4), r,\\n                   r * (1 if kind == 'ellipse' else rng.uniform(0.7, 1.4)), 0.0, kind)\\n    return np.clip(np.where(m, bg + dc, bg), C_MIN, C_MAX).astype(np.float32)\\n\\n\\ndef random_echo(rng, sos):\\n    \\\"\\\"\\\"Echogenicity map: smooth log-normal texture + inclusion-specific contrast.\\\"\\\"\\\"\\n    nz, nx = sos.shape\\n    e = np.exp(0.3 * _smooth_noise(rng, (nz, nx), 4 * nz / 64))\\n    if rng.random() < 0.5:\\n        lv = np.round((sos - sos.min()) / 15)\\n        for v in np.unique(lv):\\n            if rng.random() < 0.5:\\n                e[lv == v] *= rng.uniform(0.4, 2.0)\\n    return e.astype(np.float32)\\n\\n\\ndef downsample_sos(c_hi, f=2):\\n    \\\"\\\"\\\"Average slowness over f x f blocks (hi-res GT -> recon grid GT).\\\"\\\"\\\"\\n    nz, nx = c_hi.shape\\n    s = (1.0 / c_hi).reshape(nz // f, f, nx // f, f).mean((1, 3))\\n    return (1.0 / s).astype(np.float32)\\n\", \"sosbench/raymodel.py\": \"\\\"\\\"\\\"Straight-ray (limited-angle CT style) imaging operator A' for pulse-echo SoS\\nfrom inter-transmit delays, as used by DenOiS (simplified, linearised model).\\n\\nUnknown   u  = (1/c - 1/c_bf) * 1e6       [ns/mm]   on an (nz, nx) grid (row-major)\\nMeasured  b  = tau_{k+1} - tau_k          [ns]      at the (nz, nx) recon pixel centres,\\n                                                    k = 0..npair-1, flattened (k, z, x)\\n\\\"\\\"\\\"\\nimport numpy as np\\nimport scipy.sparse as sp\\n\\nfrom .acq import Geometry\\n\\n\\ndef _ray_matrix(geo: Geometry, k, img_nz, img_nx, img_dz, img_dx, n_samp):\\n    \\\"\\\"\\\"Travel-time-perturbation matrix for transmit k:\\n    rows = measurement pixels (geo.nz*geo.nx), cols = image pixels (img_nz*img_nx).\\n    Straight ray from its skin-entry point (x0, 0) to pixel centre p, bilinear weights.\\\"\\\"\\\"\\n    Z, X = np.meshgrid(geo.z, geo.x, indexing='ij')\\n    zp = Z.ravel(); xp = X.ravel()\\n    x0, _ = geo.ray_entry(k, zp, xp)\\n    L = np.sqrt((xp - x0) ** 2 + zp ** 2)                          # [m]\\n    s = (np.arange(n_samp) + 0.5) / n_samp                         # midpoints\\n    zs = s[None, :] * zp[:, None]\\n    xs = x0[:, None] + s[None, :] * (xp - x0)[:, None]\\n    ds = (L / n_samp)[:, None] * np.ones_like(s)[None, :] * 1e3     # [mm]\\n    # fractional image indices (pixel centres at (i+0.5)*d, x centred like geo.x)\\n    img_x0 = geo.xc - (img_nx - 1) / 2 * img_dx\\n    fi = zs / img_dz - 0.5\\n    fj = (xs - img_x0) / img_dx\\n    fi = np.clip(fi, 0, img_nz - 1); fj = np.clip(fj, 0, img_nx - 1)\\n    i0 = np.clip(np.floor(fi).astype(np.int64), 0, max(img_nz - 2, 0))\\n    j0 = np.clip(np.floor(fj).astype(np.int64), 0, max(img_nx - 2, 0))\\n    wi = fi - i0; wj = fj - j0\\n    rows = np.repeat(np.arange(zp.size), n_samp)\\n    R, C, V = [], [], []\\n    for di, wI in ((0, 1 - wi), (1, wi)):\\n        for dj, wJ in ((0, 1 - wj), (1, wj)):\\n            R.append(rows); C.append(((i0 + di) * img_nx + (j0 + dj)).ravel()); V.append((wI * wJ * ds).ravel())\\n    M = sp.coo_matrix((np.concatenate(V), (np.concatenate(R), np.concatenate(C))),\\n                      shape=(zp.size, img_nz * img_nx)).tocsr()\\n    M.sum_duplicates()\\n    return M\\n\\n\\ndef build_operator(geo: Geometry, upsample=1, n_samp=None):\\n    \\\"\\\"\\\"A' (upsample=1, recon grid) or the higher-resolution A_H (upsample=2):\\n    image grid is `upsample` times finer, measurement grid is always geo's 64x64.\\n    Returns scipy CSR of shape (npair*nz*nx, (nz*up)*(nx*up)).\\\"\\\"\\\"\\n    nz, nx = geo.nz * upsample, geo.nx * upsample\\n    dz, dx = geo.dz / upsample, geo.dx / upsample\\n    n_samp = n_samp or int(np.ceil(geo.nz * geo.dz / min(dz, dx) * 1.5))\\n    T = [_ray_matrix(geo, k, nz, nx, dz, dx, n_samp) for k in range(geo.n_tx)]\\n    pairs = [T[k + 1] - T[k] for k in range(geo.npair)]\\n    return sp.vstack(pairs).tocsr().astype(np.float32)\\n\\n\\ndef aperture_mask(geo: Geometry):\\n    \\\"\\\"\\\"Aperture (undersampling) masks: measurement valid where both transmits of the\\n    pair insonify the pixel through their aperture.  (npair, nz, nx) bool.\\\"\\\"\\\"\\n    Z, X = np.meshgrid(geo.z, geo.x, indexing='ij')\\n    ok = [geo.ray_entry(k, Z, X)[1] for k in range(geo.n_tx)]\\n    m = np.stack([ok[k] & ok[k + 1] for k in range(geo.npair)])\\n    m &= (Z >= geo.zmin_valid)[None]\\n    return m\\n\\n\\ndef directivity_maps(geo: Geometry):\\n    \\\"\\\"\\\"Prior channels hinting at depth- and angle-dependent expected variation:\\n    (npair, 2, nz, nx): normalised depth and the pair's mean steering angle.\\\"\\\"\\\"\\n    Z, X = np.meshgrid(geo.z, geo.x, indexing='ij')\\n    d = Z / Z.max()\\n    out = []\\n    for k in range(geo.npair):\\n        x0a, _ = geo.ray_entry(k, Z, X); x0b, _ = geo.ray_entry(k + 1, Z, X)\\n        # mean incidence angle of the two rays -> expected sensitivity direction\\n        th = 0.5 * (np.arctan2(X - x0a, Z) + np.arctan2(X - x0b, Z))\\n        out.append(np.stack([d, th / (np.pi / 4)]))\\n    return np.stack(out).astype(np.float32)\\n\\n\\n# ---------------------------------------------------------------- unit helpers\\n\\ndef sos_to_u(c, c_bf=1540.0):\\n    return (1.0 / c - 1.0 / c_bf) * 1e6\\n\\n\\ndef u_to_sos(u, c_bf=1540.0):\\n    return 1.0 / (1.0 / c_bf + u * 1e-6)\\n\\n\\ndef resample_gt(C, xC, zC, geo: Geometry, upsample=1):\\n    \\\"\\\"\\\"Ground-truth SoS map (k-Wave grid) -> (box-averaged) recon grid.\\\"\\\"\\\"\\n    from scipy.interpolate import RegularGridInterpolator\\n    nz, nx = geo.nz * upsample, geo.nx * upsample\\n    dz, dx = geo.dz / upsample, geo.dx / upsample\\n    sub = 5\\n    zz = (np.arange(nz * sub) + 0.5) * dz / sub\\n    xx = geo.xc + (np.arange(nx * sub) - (nx * sub - 1) / 2) * dx / sub\\n    f = RegularGridInterpolator((zC, xC), 1.0 / C, bounds_error=False, fill_value=None)\\n    Zq, Xq = np.meshgrid(zz, xx, indexing='ij')\\n    s = f(np.stack([Zq.ravel(), Xq.ravel()], -1)).reshape(nz * sub, nx * sub)\\n    s = s.reshape(nz, sub, nx, sub).mean((1, 3))                    # average slowness\\n    return (1.0 / s).astype(np.float32)\\n\", \"sosbench/smoke.py\": \"\\\"\\\"\\\"Fast end-to-end smoke test of every GPU code path (~3-6 min on a T4).\\nRun this first on Kaggle: it fails loudly if anything in the pipeline is broken.\\\"\\\"\\\"\\nimport time\\nimport numpy as np\\n\\n\\ndef run_smoke(root='impact_data', device='cuda'):\\n    import torch\\n    from .backend import get_backend\\n    from .acq import default_geometry, load_impact, observations_from_fsa\\n    from .datagen import Ops, simulate_case, set_fast_tv, TV_CFG\\n    from .wavesim import SimConfig\\n    from .phantoms import structured_sos\\n    from .nets import UNet, Diffusion, sos_norm\\n    from .solvers import dc_cg\\n    from .metrics import all_metrics\\n    from .raymodel import resample_gt\\n    import copy\\n    T = time.time()\\n    def ok(msg): print(f'[{time.time() - T:6.1f}s] OK  {msg}', flush=True)\\n    B = get_backend('torch', device); geo = default_geometry()\\n    saved = copy.deepcopy(TV_CFG); set_fast_tv(20)\\n    try:\\n        ops = Ops(B, geo, with_hi=True); ok('operators on GPU')\\n        rng = np.random.default_rng(0)\\n        hi = structured_sos(rng, 128, 128, geo.dz / 2, geo.dx / 2)\\n        cfg = SimConfig(geo)\\n        t0 = time.time(); d, r, w, comp = simulate_case(B, ops, cfg, rng, hi)\\n        assert np.isfinite(d).all() and d.shape == (8, 64, 64)\\n        ok(f'wave simulation + beamforming + tracking ({time.time() - t0:.1f}s/case, median rho {np.median(r):.2f})')\\n        l1 = ops.tv((d * w)[None], w[None], 'l1'); l2 = ops.tv((d * w)[None], w[None], 'l2')\\n        assert np.isfinite(l1).all() and np.isfinite(l2).all(); ok('L1-TV / L2-TV on GPU')\\n        # diffusion: one train step + DDIM with data consistency\\n        net = UNet(4, 1).to(device); diff = Diffusion(200, device)\\n        x0 = torch.from_numpy(sos_norm(hi[::2, ::2])[None, None].astype(np.float32)).to(device)\\n        cond = torch.cat([x0, x0], 1)\\n        opt = torch.optim.Adam(net.parameters(), 1e-3)\\n        with torch.autocast('cuda', dtype=torch.float16):\\n            loss = diff.loss(net, x0.repeat(4, 1, 1, 1), cond.repeat(4, 1, 1, 1))\\n        loss.backward(); opt.step(); ok(f'diffusion train step (loss {loss.item():.3f})')\\n        from .denois import DenoisRunner\\n        R = DenoisRunner.__new__(DenoisRunner)\\n        R.dev, R.B, R.geo, R.ops, R.nu, R.cg_iters = device, B, geo, ops, 0.03, 5\\n        R.models = {'rd': (net.eval(), diff)}\\n        X = R.rd((d * w)[None], w[None], l1, l2)\\n        assert np.isfinite(X).all(); ok('R_D inference (DDIM + CG data consistency)')\\n        Xd = diff.ddpm(net, cond, (1, 1, 64, 64), dc=R._dc_fn((d * w)[None], w[None]), K=1)\\n        assert torch.isfinite(Xd).all(); ok('DDPM sampling with DC every step (DOLCE path)')\\n        # refiner U-Net forward/backward\\n        from .train import build, refiner_inputs\\n        mu, _, _ = build('mu_bPA'); mu = mu.to(device)\\n        Xin = torch.from_numpy(refiner_inputs((d * w)[None], w[None], l1, 'bPA')).to(device)\\n        out = mu(Xin); out.mean().backward(); ok(f'refiner M_U forward/backward {tuple(out.shape)}')\\n        # real data + thesis methods (1 iteration each)\\n        data = load_impact('abd3', root)\\n        dr, rr, bm = observations_from_fsa(data, default_geometry(elx=data['elx']), B); ok('real-data observations (abd3)')\\n        from .thesis_das import DASSetup, run_das_cmpe\\n        S = DASSetup(data); rd_ = run_das_cmpe(S, device=device, iters=2, log=lambda s: None)\\n        assert np.isfinite(rd_['c_ctrl']).all(); ok(f\\\"DAS+CMPE 2 iters ({rd_['time_per_iter']:.1f}s/iter, {rd_['peak_mem_gb']:.1f} GB)\\\")\\n        from .thesis_ssfm import SSFMSetup, run_ssfm\\n        S2 = SSFMSetup(data, f_stride=16, tx_stride=4)\\n        rs = run_ssfm(S2, devices=(device,), iters_depth=1, iters_joint=1, log=lambda s: None)\\n        assert np.isfinite(rs['sos']).all(); ok(f\\\"SSFM 2 iters ({rs['time_per_iter']:.1f}s/iter, {rs['peak_mem_gb']:.1f} GB)\\\")\\n    finally:\\n        TV_CFG.clear(); TV_CFG.update(saved)\\n    print('SMOKE TEST PASSED')\\n\", \"sosbench/solvers.py\": \"\\\"\\\"\\\"Analytical reconstruction: L1-TV / L2-TV via Chambolle-Pock (batched), and the\\nconjugate-gradient data-consistency step used inside DenOiS' plug-and-play loop.\\n\\nAll solvers work in *normalised units*:\\n    A_n = A / s1         (s1 = largest singular value of A -> \\\"SVD-normalised\\\")\\n    u_n = u / U_SCALE    (u in ns/mm, U_SCALE ~ typical magnitude)\\n    b_n = b / (U_SCALE * s1)\\nArrays: u is (nb, nz, nx); b and w (weights/masks) are (nb, M).\\n\\\"\\\"\\\"\\nimport numpy as np\\n\\nU_SCALE = 30.0      # ns/mm  (|1/1400-1/1540|*1e6 = 65, |1/1650-1/1540|*1e6 = 43)\\n\\n\\ndef largest_singular_value(A, iters=60, seed=0):\\n    rng = np.random.default_rng(seed)\\n    v = rng.standard_normal(A.shape[1]).astype(np.float64)\\n    for _ in range(iters):\\n        v = A.T @ (A @ v); v /= np.linalg.norm(v)\\n    return float(np.sqrt(np.linalg.norm(A.T @ (A @ v))))\\n\\n\\nclass LinearOp:\\n    \\\"\\\"\\\"Holds the (normalised) operator on a backend, with batched apply/adjoint.\\\"\\\"\\\"\\n    def __init__(self, B, A_scipy, nz, nx, s1=None):\\n        self.B = B\\n        self.s1 = s1 or largest_singular_value(A_scipy)\\n        self.A = B.sparse((A_scipy / self.s1).astype(np.float32))\\n        self.nz, self.nx = nz, nx\\n        self.M = A_scipy.shape[0]\\n        An = abs(A_scipy) / self.s1\\n        # diagonal preconditioners (Pock & Chambolle 2011, alpha=1)\\n        rs = np.asarray(An.sum(1)).ravel(); cs = np.asarray(An.sum(0)).ravel()\\n        self.sig_A = B.asarray((1.0 / np.maximum(rs, 1e-6)).astype(np.float32))[None, :]\\n        self.tau = B.asarray((1.0 / (cs + 4.0)).astype(np.float32)).reshape(1, nz, nx)\\n\\n    def fwd(self, u):                       # (nb, nz, nx) -> (nb, M)\\n        nb = u.shape[0]\\n        return self.B.spmm(self.A, u.reshape(nb, -1).T).T\\n\\n    def adj(self, y):                       # (nb, M) -> (nb, nz, nx)\\n        nb = y.shape[0]\\n        return self.B.spmm_T(self.A, y.T).T.reshape(nb, self.nz, self.nx)\\n\\n    # unit conversions\\n    def b_to_n(self, b_ns):  return b_ns / (U_SCALE * self.s1)\\n    def n_to_b(self, b_n):   return b_n * (U_SCALE * self.s1)\\n\\n\\ndef grad(B, u):\\n    gz = B.cat([u[:, 1:] - u[:, :-1], 0 * u[:, :1]], axis=1)\\n    gx = B.cat([u[:, :, 1:] - u[:, :, :-1], 0 * u[:, :, :1]], axis=2)\\n    return gz, gx\\n\\n\\ndef div(B, pz, px):     # = -grad^T\\n    dz = B.cat([pz[:, :1], pz[:, 1:-1] - pz[:, :-2], -pz[:, -2:-1]], axis=1)\\n    dx = B.cat([px[:, :, :1], px[:, :, 1:-1] - px[:, :, :-2], -px[:, :, -2:-1]], axis=2)\\n    return dz + dx\\n\\n\\ndef tv_recon(op: LinearOp, b_n, w, lam=0.1, p=2, iters=300, u0=None):\\n    \\\"\\\"\\\"min_u  data_p(w*(A u - b)) + lam_eff * TV_iso(u)   (Chambolle-Pock / PDHG)\\n       p=2: 0.5*||.||^2,  p=1: ||.||_1.   w in [0,1] (0 = missing measurement).\\n    `lam` is a *relative* weight: lam_eff = lam * ||A^T g||_inf per sample, with\\n    g = w*b (p=2) or w*sign(b) (p=1) - the data-term gradient at u=0, so the same\\n    `lam` behaves consistently across datasets/scales.\\\"\\\"\\\"\\n    B = op.B\\n    nb = b_n.shape[0]\\n    g = w * b_n if p == 2 else w * B.sign(b_n)\\n    lam = lam * B.abs(op.adj(g)).reshape(nb, -1).max(1)[:, None, None] if B.name == 'numpy' \\\\\\n        else lam * B.abs(op.adj(g)).reshape(nb, -1).amax(1)[:, None, None]\\n    u = B.zeros((nb, op.nz, op.nx)) if u0 is None else u0\\n    ubar = u\\n    y = B.zeros((nb, op.M)); qz = B.zeros((nb, op.nz, op.nx)); qx = B.zeros((nb, op.nz, op.nx))\\n    sig = op.sig_A; tau = op.tau; sig_g = 0.5\\n    for _ in range(iters):\\n        # dual data (diagonally preconditioned)\\n        y = y + sig * op.fwd(ubar)\\n        if p == 2:\\n            y = B.where(w > 0, (y - sig * b_n) / (1 + sig / B.clip(w, 1e-6, None)), 0 * y)\\n        else:\\n            v = y - sig * b_n\\n            y = B.minimum(B.maximum(v, -w), w)\\n        # dual TV\\n        gz, gx = grad(B, ubar)\\n        qz = qz + sig_g * gz; qx = qx + sig_g * gx\\n        nrm = B.maximum(B.sqrt(qz ** 2 + qx ** 2) / lam, 1.0 + 0 * qz)\\n        qz = qz / nrm; qx = qx / nrm\\n        # primal\\n        u_old = u\\n        u = u - tau * (op.adj(y) - div(B, qz, qx))\\n        ubar = 2 * u - u_old\\n    return u\\n\\n\\ndef dc_cg(op: LinearOp, b_n, w, z, nu, iters=10):\\n    \\\"\\\"\\\"Data-consistency step (3b):  argmin_x ||w*(A x - b)||^2 + nu ||x - z||^2\\n    solved with batched conjugate gradient, warm-started at z.\\\"\\\"\\\"\\n    B = op.B\\n    def Hx(x): return op.adj(w * op.fwd(x)) + nu * x\\n    x = z\\n    r = op.adj(w * b_n) + nu * z - Hx(x)\\n    pdir = r\\n    rs = B.sum((r * r).reshape(r.shape[0], -1), axis=1)\\n    for _ in range(iters):\\n        Ap = Hx(pdir)\\n        alpha = rs / (B.sum((pdir * Ap).reshape(r.shape[0], -1), axis=1) + 1e-12)\\n        x = x + alpha[:, None, None] * pdir\\n        r = r - alpha[:, None, None] * Ap\\n        rs_new = B.sum((r * r).reshape(r.shape[0], -1), axis=1)\\n        pdir = r + (rs_new / (rs + 1e-12))[:, None, None] * pdir\\n        rs = rs_new\\n    return x\\n\\n\\ndef tv_irls(op: LinearOp, b_n, w, lam=1e-3, p=2, outer=12, inner=25, eps=1e-3, delta=None, u0=None):\\n    \\\"\\\"\\\"min_u  data_p(w*(A u - b)) + lam * sum sqrt(|grad u|^2 + eps^2)\\n    by iteratively re-weighted least squares; each outer step solves\\n        (A^T Om A + lam G^T D G) u = A^T Om b      with batched CG (warm start)\\n    Om = w (p=2) or w / max(|r|, delta) (p=1);  D = 1 / sqrt(|grad u|^2 + eps^2).\\n    Converges robustly for both norms (unlike plain PDHG on this ill-posed operator).\\\"\\\"\\\"\\n    B = op.B\\n    nb = b_n.shape[0]\\n    u = B.zeros((nb, op.nz, op.nx)) if u0 is None else u0\\n    if delta is None:\\n        delta = 0.05 * B.mean(B.abs(b_n), axis=1, keepdims=True) + 1e-9\\n    Om = w\\n    for it in range(outer):\\n        gz, gx = grad(B, u)\\n        D = 1.0 / B.sqrt(gz ** 2 + gx ** 2 + eps ** 2)\\n        if p == 1 and it > 0:\\n            r = op.fwd(u) - b_n\\n            Om = w / B.maximum(B.abs(r), delta + 0 * r)\\n            Om = Om / (B.mean(Om, axis=1, keepdims=True) / (B.mean(w, axis=1, keepdims=True) + 1e-9) + 1e-12)\\n\\n        def H(v):\\n            vz, vx = grad(B, v)\\n            return op.adj(Om * op.fwd(v)) - lam * div(B, D * vz, D * vx)\\n        rhs = op.adj(Om * b_n)\\n        x = u\\n        r = rhs - H(x); pdir = r\\n        rs = B.sum((r * r).reshape(nb, -1), axis=1)\\n        for _ in range(inner):\\n            Ap = H(pdir)\\n            alpha = rs / (B.sum((pdir * Ap).reshape(nb, -1), axis=1) + 1e-20)\\n            x = x + alpha[:, None, None] * pdir\\n            r = r - alpha[:, None, None] * Ap\\n            rs_new = B.sum((r * r).reshape(nb, -1), axis=1)\\n            pdir = r + (rs_new / (rs + 1e-20))[:, None, None] * pdir\\n            rs = rs_new\\n        u = x\\n    return u\\n\", \"sosbench/thesis_das.py\": \"\\\"\\\"\\\"Thesis method 1 \\u2014 differentiable straight-ray delay-and-sum with the common-midpoint\\nphase-error loss (DAS+CMPE; Simson et al. 2023/2024 dbua, ported to PyTorch as in Meng 2026).\\n\\n    tau(e, p)   = |p - e| * mean_k s(x_k)          straight ray, slowness on a coarse control grid\\n    q_ij(p)     = chi_ij(p) * IQ_ij(tau_i + tau_j - t0) * exp(i 2pi fc (tau_i + tau_j))\\n    I_ab(p)     = sum_i A_ai sum_j B_bj q_ij(p)    17-element translated sub-apertures\\n    Gamma       = sum_{p in patch} I_ab conj(I_{a+1,b-1})       common mid-point pairs\\n    L_RPE       = mean_valid log(1 + beta^2 angle(Gamma)^2)     (coherence-gated, beta=100)\\n    J           = L_RPE + lam * (mean (d_x c)^2 + mean (d_z c)^2)\\nAdam on the control-grid SoS (lr 10 m/s), 150 iterations from 1540 m/s.\\n\\\"\\\"\\\"\\nimport time\\nimport numpy as np\\n\\n\\ndef fsa_iq(scat, t, fc, bw, fs_out=32e6, t_max=60e-6, tx_chunk=16):\\n    \\\"\\\"\\\"FSA RF -> baseband IQ (ntx, nrx, nt_out).\\\"\\\"\\\"\\n    nt, nrx, ntx = scat.shape\\n    fs = 1 / np.mean(np.diff(t))\\n    f = np.fft.rfftfreq(nt, 1 / fs)\\n    band = np.where((f > max(fc - bw / 2, 0.2e6)) & (f < fc + bw / 2))[0]\\n    fb = f[band]\\n    nt_out = int(np.ceil((t_max - t[0]) * fs_out))\\n    t_out = t[0] + np.arange(nt_out) / fs_out\\n    E = np.exp(2j * np.pi * fb[:, None] * (t_out[None, :] - t[0]) - 2j * np.pi * fc * t_out[None, :]).astype(np.complex64)\\n    iq = np.zeros((ntx, nrx, nt_out), np.complex64)\\n    for c0 in range(0, ntx, tx_chunk):\\n        S = np.fft.rfft(scat[:, :, c0:c0 + tx_chunk], axis=0)[band].astype(np.complex64)   # (nf, nrx, ntc)\\n        iq[c0:c0 + tx_chunk] = np.einsum('frt,fn->trn', S, E, optimize=True) * (2.0 / nt)\\n    return iq, t_out\\n\\n\\nclass DASSetup:\\n    def __init__(self, data, fc=None, bw=None, ctrl_shape=(31, 19), ctrl_x=(-12e-3, 12e-3), ctrl_z=(0, 38.4e-3),\\n                 n_patch=17, patch_k=5, patch_dx=None, pe_x=(-12.7e-3, 12.7e-3), pe_z=(5e-3, 40e-3),\\n                 subap=17, sub_stride=8, fnum=0.75, fs_out=32e6, n_ray=32):\\n        fc = fc or data['fc']; bw = bw or data['bw']\\n        self.fc = fc\\n        elx = data['elx']; self.elx = elx.astype(np.float32); self.xc = float(elx.mean())\\n        self.iq, self.t_out = fsa_iq(data['scat'], data['t'], fc, bw, fs_out, t_max=2.3 * pe_z[1] / 1400 + 3e-6)\\n        self.fs = fs_out\\n        lam = 1540 / fc\\n        pdx = patch_dx or lam / 2\\n        cx = self.xc + np.linspace(pe_x[0], pe_x[1], n_patch); cz = np.linspace(pe_z[0], pe_z[1], n_patch)\\n        off = (np.arange(patch_k) - (patch_k - 1) / 2) * pdx\\n        PZ, PX = np.meshgrid(cz, cx, indexing='ij')                                   # (np, np)\\n        self.px = (PX.reshape(-1, 1, 1) + off[None, None, :]).repeat(patch_k, 1).reshape(-1).astype(np.float32)\\n        self.pz = (PZ.reshape(-1, 1, 1) + off[None, :, None]).repeat(patch_k, 2).reshape(-1).astype(np.float32)\\n        self.n_patches = n_patch * n_patch; self.patch_px = patch_k * patch_k\\n        nel = len(elx)\\n        centers = np.arange(subap // 2, nel - subap // 2, sub_stride)\\n        A = np.zeros((len(centers), nel), np.float32)\\n        for k, c in enumerate(centers): A[k, c - subap // 2: c + subap // 2 + 1] = 1\\n        self.A = A\\n        self.ctrl_shape = ctrl_shape\\n        self.ctrl_x = self.xc + np.linspace(ctrl_x[0], ctrl_x[1], ctrl_shape[1])\\n        self.ctrl_z = np.linspace(ctrl_z[0], ctrl_z[1], ctrl_shape[0])\\n        self.fnum = fnum; self.n_ray = n_ray\\n\\n\\ndef _tof(B, S, c_ctrl, ex, px, pz):\\n    \\\"\\\"\\\"Straight-ray travel time element->pixel. ex: (nel,), px/pz: (P,) -> (nel, P) [s].\\\"\\\"\\\"\\n    nzc, nxc = S.ctrl_shape\\n    s_ctrl = 1.0 / c_ctrl\\n    k = (B.arange(S.n_ray) + 0.5) / S.n_ray                                         # (K,)\\n    xs = ex[:, None, None] + k[None, None, :] * (px[None, :, None] - ex[:, None, None])\\n    zs = k[None, None, :] * pz[None, :, None] + 0 * ex[:, None, None]\\n    fx = (xs - float(S.ctrl_x[0])) / float(S.ctrl_x[1] - S.ctrl_x[0])\\n    fz = (zs - float(S.ctrl_z[0])) / float(S.ctrl_z[1] - S.ctrl_z[0])\\n    sv = B.interp2(s_ctrl, fz, fx)                                                  # (nel, P, K)\\n    L = B.sqrt((px[None, :] - ex[:, None]) ** 2 + pz[None, :] ** 2)\\n    return L * B.mean(sv, axis=2)\\n\\n\\ndef _subap_images(B, S, iq, tau, ex, px, pz, tx_idx):\\n    \\\"\\\"\\\"For transmit elements tx_idx: S_ib(p) = sum_j B_bj q_ij(p). Returns (len(tx_idx), nsub, P).\\\"\\\"\\\"\\n    nt = iq.shape[-1]; t0 = float(S.t_out[0])\\n    Bw = B.asarray(S.A)                                                              # rx sub-aperture weights\\n    chi_rx = (B.abs(px[None, :] - ex[:, None]) * 2 * S.fnum <= pz[None, :])         # (nrx, P)\\n    chi_rx = chi_rx.astype(np.float32) if B.name == 'numpy' else chi_rx.float()\\n    out = []\\n    for i in tx_idx:\\n        T = tau[i][None, :] + tau                                                      # (nrx, P)\\n        idx = (T - t0) * S.fs\\n        i0 = B.clip(B.floor(idx), 0, nt - 2); w = idx - i0\\n        i0l = i0.astype(np.int64) if B.name == 'numpy' else i0.long()\\n        sig = iq[i]                                                                    # (nrx, nt)\\n        s0 = B.take_along(sig, i0l, 1); s1 = B.take_along(sig, i0l + 1, 1)\\n        chi_tx = (B.abs(px - float(S.elx[i])) * 2 * S.fnum <= pz)\\n        chi_tx = chi_tx.astype(np.float32) if B.name == 'numpy' else chi_tx.float()\\n        q = (s0 * (1 - w) + s1 * w) * B.polar(2 * np.pi * S.fc * T) * chi_rx * chi_tx[None, :]\\n        out.append(B.einsum('bj,jp->bp', Bw.astype(np.complex64) if B.name == 'numpy' else Bw.to(q.dtype), q))\\n    return B.stack(out, 0)\\n\\n\\ndef cmpe_loss(B, S, I, beta=100.0, eta=0.5):\\n    \\\"\\\"\\\"I: (nsub, nsub, P) sub-aperture images.  Common-midpoint pairs (a,b)~(a+1,b-1).\\\"\\\"\\\"\\n    ns = I.shape[0]\\n    Ip = I.reshape(ns, ns, S.n_patches, S.patch_px)\\n    X1 = Ip[:-1, 1:]; X2 = Ip[1:, :-1]\\n    G = B.sum(X1 * B.conj(X2), axis=-1)\\n    E1 = B.sum(B.abs(X1) ** 2, axis=-1); E2 = B.sum(B.abs(X2) ** 2, axis=-1)\\n    rho2 = B.abs(G) ** 2 / (E1 * E2 + 1e-30)\\n    valid = rho2 > eta ** 2\\n    Gs = B.where(valid, G, 0 * G + 1)                    # avoid angle'(0) = NaN in masked entries\\n    dphi = B.angle(Gs)\\n    vf = valid.astype(np.float32) if B.name == 'numpy' else valid.float()\\n    L = B.sum(B.log1p((beta * dphi) ** 2) * vf) / (B.sum(vf) + 1e-9)\\n    pe = B.sum(B.abs(dphi) * vf) / (B.sum(vf) + 1e-9)\\n    return L, pe, B.sum(vf)\\n\\n\\ndef das_cmpe_forward_numpy(S: DASSetup, c_ctrl):\\n    from .backend import get_backend\\n    B = get_backend('numpy')\\n    ex = S.elx; px, pz = S.px, S.pz\\n    tau = _tof(B, S, c_ctrl.astype(np.float32), ex, px, pz)\\n    Sib = _subap_images(B, S, S.iq, tau, ex, px, pz, range(len(ex)))                 # (ntx, nsub, P)\\n    I = np.einsum('ai,ibp->abp', S.A.astype(np.complex64), Sib)\\n    return cmpe_loss(B, S, I)\\n\\n\\ndef run_das_cmpe(S: DASSetup, device='cuda:0', iters=150, lr=10.0, lam=1e-3, c_init=1540.0, tx_chunk=8,\\n                 beta=100.0, eta=0.5, log=print):\\n    import torch\\n    from torch.utils.checkpoint import checkpoint\\n    from .backend import get_backend\\n    B = get_backend('torch', device)\\n    dev = torch.device(device)\\n    iq = torch.from_numpy(S.iq).to(dev)\\n    ex = torch.from_numpy(S.elx).to(dev); px = torch.from_numpy(S.px).to(dev); pz = torch.from_numpy(S.pz).to(dev)\\n    A = torch.from_numpy(S.A).to(dev).to(torch.complex64)\\n    c = torch.full(S.ctrl_shape, c_init, device=dev, requires_grad=True)\\n    opt = torch.optim.Adam([c], lr=lr)\\n    nel = len(S.elx)\\n    torch.cuda.reset_peak_memory_stats(dev)\\n    hist = []; t0 = time.time()\\n\\n    def chunk(tau, i0, i1):\\n        return _subap_images(B, S, iq, tau, ex, px, pz, range(i0, i1))\\n\\n    for it in range(iters):\\n        opt.zero_grad(set_to_none=True)\\n        tau = _tof(B, S, c, ex, px, pz)                                   # (nel, P), differentiable\\n        I = 0\\n        for i0 in range(0, nel, tx_chunk):\\n            i1 = min(nel, i0 + tx_chunk)\\n            Sib = checkpoint(chunk, tau, i0, i1, use_reentrant=False)\\n            I = I + torch.einsum('ai,ibp->abp', A[:, i0:i1], Sib)\\n        L, pe, nv = cmpe_loss(B, S, I, beta, eta)\\n        reg = ((c[:, 1:] - c[:, :-1]) ** 2).mean() + ((c[1:] - c[:-1]) ** 2).mean()\\n        J = L + lam * reg\\n        J.backward()\\n        opt.step()\\n        with torch.no_grad():\\n            c.clamp_(1350, 1700)\\n        hist.append(dict(it=it, loss=float(L), pe=float(pe), n_valid=float(nv)))\\n        if it % 10 == 0 or it == iters - 1:\\n            log(f'  DAS+CMPE {it + 1}/{iters}  L_RPE={float(L):.3f}  PE={float(pe):.4f} rad  valid={int(nv)}  {time.time() - t0:.0f}s')\\n    return dict(c_ctrl=c.detach().cpu().numpy(), ctrl_z=S.ctrl_z, ctrl_x=S.ctrl_x, history=hist,\\n                time_per_iter=(time.time() - t0) / iters, peak_mem_gb=torch.cuda.max_memory_allocated(dev) / 1e9)\\n\\n\\ndef ctrl_to_grid(c_ctrl, ctrl_z, ctrl_x, z, x):\\n    \\\"\\\"\\\"Bilinear interpolation of the control-grid SoS onto an evaluation grid.\\\"\\\"\\\"\\n    from scipy.interpolate import RegularGridInterpolator\\n    f = RegularGridInterpolator((ctrl_z, ctrl_x), c_ctrl, bounds_error=False, fill_value=None)\\n    Z, X = np.meshgrid(np.clip(z, ctrl_z[0], ctrl_z[-1]), np.clip(x, ctrl_x[0], ctrl_x[-1]), indexing='ij')\\n    return f(np.stack([Z.ravel(), X.ravel()], -1)).reshape(Z.shape).astype(np.float32)\\n\", \"sosbench/thesis_ssfm.py\": \"\\\"\\\"\\\"Thesis method 2 \\u2014 Fourier split-step (SSFM) wavefield model with reflection-matrix\\nfocusing-quality optimisation (Meng 2026, following Ali et al. IMPACT and Lambert et al.).\\n\\nForward (per transmit element i, frequency f), IMPACT conventions:\\n    rx_i(x,0,f) = apod * P_i(x,f) e^{-i2pi f t0}  (nearest-neighbour embedding)\\n    tx_i(x,0,f) = delta(x - x_i)\\n    rx <- dH  * W IFFT[ H  * FFT[W rx]]          H = exp(+i2pi kz dz), dH = exp(+i2pi f (s - s_mean) dz)\\n    tx <- dH* * W IFFT[ H* * FFT[W tx]]\\nFocused reflection matrix at depth z (confocal band |x_in - x_out| <= w):\\n    R(x_in, x_out) = sum_{i,f} tx_i(x_in) conj(rx_i(x_out))\\n    F_RM = < |R(x,x)|^2 / sum_{|d|<=w} |R(x+d,x)|^2 >_ROI          (maximised)\\nObjective: -F_RM + aniso-TV(slowness);  slowness = s_m(z) + ds(z,x), two stages\\n(50 depth-only + 100 joint iterations), Adam, partial 3x3 median filter (blend 0.5).\\n\\nMemory: the propagation is checkpointed over depth chunks, frequencies are\\nstrided and transmit elements can be split across two GPUs (T4-friendly).\\\"\\\"\\\"\\nimport time\\nimport numpy as np\\n\\n\\ndef opt_apod(nel, nlags=1, tol=1e-12, seed=0):\\n    \\\"\\\"\\\"Short-lag-coherence optimal apodisation (port of IMPACT optApod).\\\"\\\"\\\"\\n    L = np.diag(2.0 * nlags * np.ones(nel))\\n    for lag in range(1, nlags + 1):\\n        L -= np.diag(np.ones(nel - lag), k=lag) + np.diag(np.ones(nel - lag), k=-lag)\\n    a = np.random.default_rng(seed).standard_normal(nel)\\n    prev, cur = 0.0, 1.0\\n    for _ in range(200):\\n        prev = cur\\n        a = np.abs(a) / np.linalg.norm(a)\\n        M = np.block([[L, a[:, None]], [a[None, :], np.zeros((1, 1))]])\\n        sol = np.linalg.solve(M, np.concatenate([np.zeros(nel), [1.0]]))\\n        a = sol[:nel]; cur = sol[-1]\\n        if abs(np.linalg.norm(a) - 1) < tol and abs((cur - prev) / cur) < tol:\\n            break\\n    return a\\n\\n\\nclass SSFMSetup:\\n    \\\"\\\"\\\"Pre-computed boundary wavefields and grids (numpy).\\\"\\\"\\\"\\n    def __init__(self, data, fc=None, bw=None, dov=40e-3, upsamp_x=2, nx0=None, f_stride=4, tx_stride=1,\\n                 c0=1540.0, ord_aa=50, roi_x=(-12e-3, 12e-3), roi_z=(2e-3, 38.4e-3), confocal_w=None):\\n        fc = fc or data['fc']; bw = bw or data['bw']\\n        elx = data['elx']; t = data['t']; scat = data['scat']\\n        nt, nrx, ntx = scat.shape\\n        pitch = float(np.mean(np.diff(elx)))\\n        self.xc = float(elx.mean())\\n        nx0 = nx0 or int(np.ceil((elx.max() - elx.min()) / pitch)) + 33            # ~aperture + margin\\n        self.x = self.xc + (pitch / upsamp_x) * (np.arange(upsamp_x * nx0) - (upsamp_x * nx0 - 1) / 2)\\n        lam = c0 / fc\\n        self.dz = lam / 2\\n        self.z = np.arange(int(round(dov / self.dz))) * self.dz\\n        xmax = (np.max(np.abs(elx - self.xc)) + np.max(np.abs(self.x - self.xc))) / 2\\n        self.aawin = (1 / np.sqrt(1 + ((self.x - self.xc) / xmax) ** ord_aa)).astype(np.float32)\\n        fs = 1 / np.mean(np.diff(t))\\n        f = np.fft.rfftfreq(nt, 1 / fs)\\n        band = np.where((f >= fc - bw / 2) & (f <= fc + bw / 2) & (f > 0))[0][::f_stride]\\n        self.f = f[band].astype(np.float32)\\n        tx_sel = np.arange(0, ntx, tx_stride)\\n        apod = opt_apod(nrx, 1)\\n        # receive boundary: (nx, nf, ntx_sel)\\n        P = np.fft.rfft(scat[:, :, tx_sel], axis=0)[band]                          # (nf, nrx, ntxs)\\n        P = P * np.exp(-2j * np.pi * self.f[:, None, None] * t[0]) * apod[None, :, None]\\n        idx = np.clip(np.round((self.x - elx[0]) / pitch).astype(int), 0, nrx - 1)\\n        inside = (self.x >= elx.min() - pitch / 2) & (self.x <= elx.max() + pitch / 2)\\n        rx = np.transpose(P, (1, 0, 2))[idx] * inside[:, None, None]\\n        self.rx0 = rx.astype(np.complex64)\\n        tx = np.zeros((len(self.x), len(self.f), len(tx_sel)), np.complex64)\\n        for k, i in enumerate(tx_sel):\\n            tx[np.argmin(np.abs(self.x - elx[i])), :, k] = 1.0\\n        self.tx0 = tx\\n        dxg = self.x[1] - self.x[0]\\n        self.confocal_w = confocal_w or max(2, int(round(1.5 * lam / dxg)))       # ~1.5 wavelengths\\n        Xr = self.x - self.xc\\n        self.roi_cols = np.where((Xr >= roi_x[0]) & (Xr <= roi_x[1]))[0]\\n        self.roi_rows = np.where((self.z >= roi_z[0]) & (self.z <= roi_z[1]))[0]\\n        self.c0 = c0\\n        print(f'SSFM grid: nx={len(self.x)} nz={len(self.z)} nf={len(self.f)} ntx={len(tx_sel)} '\\n              f'confocal w={self.confocal_w}  field {self.rx0.nbytes / 1e6:.0f} MB', flush=True)\\n\\n\\ndef _prop(B, F, f, kx, smean, ds, dz, W, conj):\\n    \\\"\\\"\\\"IMPACT propagate() for one field. F: (nx, nf, ntx).\\\"\\\"\\\"\\n    kz2 = (f[None, :] * smean) ** 2 - kx[:, None] ** 2                          # (nx, nf)\\n    ok = kz2 > 0\\n    okf = ok.astype(np.float32) if B.name == 'numpy' else ok.float()\\n    kz = B.sqrt(B.clip(kz2, 1.0, None))            # clamp >0 keeps d sqrt finite (branch-point regularisation)\\n    sgn = -1.0 if conj else 1.0\\n    H = B.polar(sgn * 2 * np.pi * kz * dz) * okf\\n    dH = B.polar(sgn * 2 * np.pi * f[None, :] * ds[:, None] * dz)               # (nx, nf)\\n    G = B.fft(W[:, None, None] * F, axis=0)\\n    return dH[:, :, None] * W[:, None, None] * B.ifft(H[:, :, None] * G, axis=0)\\n\\n\\ndef _depth_terms(B, tx, rx, w, cols):\\n    \\\"\\\"\\\"Confocal reflection-matrix focusing terms at one depth.\\n    Returns (num, den) per ROI column: |R(x,x)|^2 and sum_{|d|<=w} |R(x+d,x)|^2.\\\"\\\"\\\"\\n    nx = tx.shape[0]\\n    num = None; den = 0\\n    for d in range(-w, w + 1):\\n        lo, hi = max(0, -d), min(nx, nx - d)\\n        Rd = B.sum(B.sum(tx[lo + d:hi + d] * B.conj(rx[lo:hi]), axis=2), axis=1)  # R(x+d, x), x in [lo,hi)\\n        full = B.pad(B.real(Rd) ** 2 + B.imag(Rd) ** 2, [(lo, nx - hi)])\\n        den = den + full\\n        if d == 0: num = full\\n    return num[cols], den[cols]\\n\\n\\ndef ssfm_forward_numpy(setup: SSFMSetup, sos_grid, B=None):\\n    \\\"\\\"\\\"Forward evaluation (no gradients) of the focusing criterion and complex image\\n    for a given SoS map on (setup.z, setup.x).  For validation on CPU.\\\"\\\"\\\"\\n    from .backend import get_backend\\n    B = B or get_backend('numpy')\\n    s = 1.0 / sos_grid.astype(np.float32)\\n    kx = np.fft.fftfreq(len(setup.x), setup.x[1] - setup.x[0]).astype(np.float32)\\n    tx, rx = setup.tx0.copy(), setup.rx0.copy()\\n    img = np.zeros((len(setup.z), len(setup.x)), np.complex64)\\n    F = []\\n    for iz in range(len(setup.z) - 1):\\n        layer = 0.5 * (s[iz] + s[iz + 1]); sm = layer.mean(); ds = layer - sm\\n        rx = _prop(B, rx, setup.f, kx, sm, ds, setup.dz, setup.aawin, conj=False)\\n        tx = _prop(B, tx, setup.f, kx, sm, ds, setup.dz, setup.aawin, conj=True)\\n        img[iz + 1] = np.sum(tx * np.conj(rx), axis=(1, 2))\\n        if iz + 1 in set(setup.roi_rows):\\n            num, den = _depth_terms(B, tx, rx, setup.confocal_w, setup.roi_cols)\\n            F.append(np.mean(num / (den + 1e-12 * den.max() + 1e-30)))\\n    return float(np.mean(F)), img\\n\\n\\n# ------------------------------------------------------------------ torch optimisation\\ndef run_ssfm(setup: SSFMSetup, devices=('cuda:0',), iters_depth=50, iters_joint=100, lr_m=3e-3, lr_d=6e-3,\\n             alpha_x=5.0, alpha_z=2.0, lam_tv=1.0, median_blend=0.5, c_init=None, chunk=12,\\n             c_bounds=(1350.0, 1700.0), log=print):\\n    \\\"\\\"\\\"Two-stage SSFM optimisation. Slowness parameterised in s/km.\\n    Returns dict(sos (nz,nx) on setup grid, history, time_per_iter, peak_mem_gb).\\\"\\\"\\\"\\n    import torch\\n    from torch.utils.checkpoint import checkpoint\\n    from .backend import get_backend\\n    devs = [torch.device(d) for d in devices]\\n    Bs = {d: get_backend('torch', str(d)) for d in devs}\\n    nz, nx = len(setup.z), len(setup.x)\\n    c_init = c_init or setup.c0\\n    # split transmit elements across devices\\n    ntx = setup.tx0.shape[2]\\n    parts = np.array_split(np.arange(ntx), len(devs))\\n    TX0 = [torch.from_numpy(setup.tx0[:, :, p]).to(d) for p, d in zip(parts, devs)]\\n    RX0 = [torch.from_numpy(setup.rx0[:, :, p]).to(d) for p, d in zip(parts, devs)]\\n    fT = [torch.from_numpy(setup.f).to(d) for d in devs]\\n    kxT = [torch.from_numpy(np.fft.fftfreq(nx, setup.x[1] - setup.x[0]).astype(np.float32)).to(d) for d in devs]\\n    WT = [torch.from_numpy(setup.aawin).to(d) for d in devs]\\n    roi_rows = set(int(r) for r in setup.roi_rows)\\n    cols = torch.from_numpy(setup.roi_cols).to(devs[0])\\n    d0 = devs[0]\\n    s_m = torch.full((nz,), 1e3 / c_init, device=d0, requires_grad=True)                # s/km\\n    s_d = torch.zeros((nz, nx), device=d0, requires_grad=True)\\n    smin, smax = 1e3 / c_bounds[1], 1e3 / c_bounds[0]\\n\\n    def chunk_fn(z0, z1, slow_km, *fields):\\n        \\\"\\\"\\\"Propagate fields through depths z0..z1-1 and return updated fields + focusing sum/count.\\\"\\\"\\\"\\n        k = len(devs)\\n        txs, rxs = list(fields[:k]), list(fields[k:])\\n        acc = torch.zeros((), device=d0); cnt = 0\\n        for iz in range(z0, z1):\\n            layer = 0.5 * (slow_km[iz] + slow_km[min(iz + 1, nz - 1)]) * 1e-3              # s/m\\n            sm = layer.mean(); ds = layer - sm\\n            nums, dens = 0, 0\\n            for j, d in enumerate(devs):\\n                B = Bs[d]\\n                lj, smj, dsj = layer.to(d), sm.to(d), ds.to(d)\\n                rxs[j] = _prop(B, rxs[j], fT[j], kxT[j], smj, dsj, setup.dz, WT[j], conj=False)\\n                txs[j] = _prop(B, txs[j], fT[j], kxT[j], smj, dsj, setup.dz, WT[j], conj=True)\\n            if iz + 1 in roi_rows:\\n                # reflection matrix needs the sum over ALL transmits before |.|^2\\n                w = setup.confocal_w\\n                num = None; den = 0\\n                for dd in range(-w, w + 1):\\n                    lo, hi = max(0, -dd), min(nx, nx - dd)\\n                    R = 0\\n                    for j, d in enumerate(devs):\\n                        R = R + (txs[j][lo + dd:hi + dd] * rxs[j][lo:hi].conj()).sum((1, 2)).to(d0)\\n                    full = torch.nn.functional.pad(R.real ** 2 + R.imag ** 2, (lo, nx - hi))\\n                    den = den + full\\n                    if dd == 0: num = full\\n                num, den = num[cols], den[cols]\\n                acc = acc + (num / (den + 1e-12 * den.detach().max() + 1e-30)).mean(); cnt += 1\\n        return (*txs, *rxs, acc, torch.tensor(float(cnt), device=d0))\\n\\n    def objective(slow_km):\\n        fields = [t.clone() for t in TX0] + [r.clone() for r in RX0]\\n        tot = 0; n = 0\\n        for z0 in range(0, nz - 1, chunk):\\n            z1 = min(nz - 1, z0 + chunk)\\n            out = checkpoint(chunk_fn, z0, z1, slow_km, *fields, use_reentrant=False)\\n            fields = list(out[:-2]); tot = tot + out[-2]; n += out[-1].item()\\n        F_rm = tot / max(n, 1)\\n        tv = alpha_z * (slow_km[1:] - slow_km[:-1]).abs().mean() + alpha_x * (slow_km[:, 1:] - slow_km[:, :-1]).abs().mean()\\n        return -F_rm + lam_tv * tv, F_rm.detach()\\n\\n    hist = []; t_start = time.time()\\n    for d in devs: torch.cuda.reset_peak_memory_stats(d)\\n    for stage, iters in (('depth', iters_depth), ('joint', iters_joint)):\\n        params = [{'params': [s_m], 'lr': lr_m}] + ([{'params': [s_d], 'lr': lr_d}] if stage == 'joint' else [])\\n        opt = torch.optim.Adam(params)\\n        for it in range(iters):\\n            opt.zero_grad(set_to_none=True)\\n            slow = s_m[:, None] + (s_d if stage == 'joint' else s_d.detach() * 0)\\n            loss, Frm = objective(slow)\\n            loss.backward()\\n            opt.step()\\n            with torch.no_grad():\\n                if stage == 'joint':\\n                    full = (s_m[:, None] + s_d).clamp(smin, smax)\\n                    med = Bs[d0].median3(full)\\n                    full = median_blend * full + (1 - median_blend) * med\\n                    s_m.copy_(full.mean(1)); s_d.copy_(full - s_m[:, None])\\n                else:\\n                    s_m.clamp_(smin, smax)\\n            hist.append(dict(stage=stage, it=it, loss=float(loss), F=float(Frm)))\\n            if it % 10 == 0 or it == iters - 1:\\n                log(f'  SSFM {stage} {it + 1}/{iters}  F_RM={float(Frm):.4f}  loss={float(loss):.4f}  {time.time() - t_start:.0f}s')\\n    sos = (1e3 / (s_m[:, None] + s_d)).detach().cpu().numpy()\\n    n_it = iters_depth + iters_joint\\n    mem = max(torch.cuda.max_memory_allocated(d) for d in devs) / 1e9\\n    return dict(sos=sos, z=setup.z, x=setup.x, history=hist, time_per_iter=(time.time() - t_start) / n_it, peak_mem_gb=mem)\\n\", \"sosbench/train.py\": \"\\\"\\\"\\\"Training CLI for every learned component.\\n\\n    python -m sosbench.train --model rd     --data S.npz  --epochs 150 --out ckpt/rd_S.pt\\n    python -m sosbench.train --model rd     --data C1.npz --epochs 100 --init ckpt/rd_S.pt --out ckpt/rd.pt\\n    python -m sosbench.train --model mu_bPA --data C1.npz --epochs 150 --out ckpt/mu_bPA.pt\\n\\nModels\\n    rd       DenOiS reconstruction diffusion R_D, conditioned on {L1-TV, L2-TV}       (eps, L2)\\n    dolce    DOLCE baseline diffusion, conditioned on L2-TV                           (eps, L2)\\n    unetR    Unet(M_U): U-Net {L1-TV, L2-TV} -> x  (simple R inside DenOiS)            (L2)\\n    direct   Unet [Chen & Han]: delay maps + masks -> x                                (L2)\\n    mu_<v>   U-Net measurement refiner M_U,  v in {b, bP, bPA}                         (L1)\\n    md_<v>   diffusion measurement refiner M_D, v in {b, bP, bPA}                      (eps, L2)\\n\\\"\\\"\\\"\\nimport argparse, copy, os, time\\nimport numpy as np\\nimport torch\\nimport torch.nn.functional as F\\n\\nfrom .nets import UNet, Diffusion, sos_norm, B_SCALE, count_params\\nfrom .acq import default_geometry\\nfrom .raymodel import build_operator, aperture_mask, directivity_maps, sos_to_u\\n\\nCOND_CH = dict(b=1, bP=5, bPA=6)\\n\\n\\ndef build(kind):\\n    \\\"\\\"\\\"Returns (model, diffusion-or-None, description).\\\"\\\"\\\"\\n    if kind in ('rd', 'dolce'):\\n        nc = 2 if kind == 'rd' else 1\\n        return UNet(1 + nc + 1, 1, base=64, mults=(1, 2, 2, 2), use_t=True), Diffusion(200), f'diffusion, {nc} cond'\\n    if kind == 'unetR':\\n        return UNet(2, 1, base=64, use_t=False, dropout=0.0), None, 'unet l1,l2->x'\\n    if kind == 'direct':\\n        return UNet(16, 1, base=64, use_t=False, dropout=0.0), None, 'unet b,w->x'\\n    v = kind.split('_')[1]\\n    if kind.startswith('mu_'):\\n        return UNet(COND_CH[v], 1, base=64, mults=(1, 2, 2, 2), attn_levels=(), use_t=False, dropout=0.0), None, 'refiner unet'\\n    if kind.startswith('md_'):\\n        return UNet(1 + COND_CH[v] + 1, 1, base=64, mults=(1, 2, 2, 2), use_t=True), Diffusion(200), 'refiner diffusion'\\n    raise ValueError(kind)\\n\\n\\n# ------------------------------------------------------------------ refiner inputs\\n_GEO_CACHE = {}\\n\\n\\ndef refiner_static(geo=None):\\n    \\\"\\\"\\\"Static prior channels P (except the data-dependent low-correlation mask).\\\"\\\"\\\"\\n    key = 'default' if geo is None else id(geo)\\n    geo = geo or default_geometry()\\n    if key not in _GEO_CACHE:\\n        _GEO_CACHE[key] = dict(ap=aperture_mask(geo).astype(np.float32), dirm=directivity_maps(geo),\\n                               A=build_operator(geo))\\n    return _GEO_CACHE[key]\\n\\n\\ndef refiner_inputs(b, w, xprime, variant, geo=None):\\n    \\\"\\\"\\\"Per-pair refiner input stack.\\n    b, w: (n, 8, 64, 64) observed delays [ns] and validity; xprime: (n, 64, 64) SoS\\n    estimate used for the A'x' prior.  Returns float32 (n*8, C, 64, 64).\\\"\\\"\\\"\\n    st = refiner_static(geo)\\n    n, npair = b.shape[:2]\\n    chans = [b / B_SCALE]\\n    if 'P' in variant:\\n        ap = np.broadcast_to(st['ap'][None], b.shape)\\n        lowc = ap * (1 - w)                                                   # in aperture but below SNR\\n        chans += [ap, lowc, np.broadcast_to(st['dirm'][None, :, 0], b.shape), np.broadcast_to(st['dirm'][None, :, 1], b.shape)]\\n    if 'A' in variant:\\n        Ax = (st['A'] @ sos_to_u(xprime.reshape(n, -1)).T).T.reshape(b.shape)\\n        chans.append(Ax / B_SCALE)\\n    X = np.stack(chans, 2).astype(np.float32)                               # (n, 8, C, 64, 64)\\n    return X.reshape(n * npair, X.shape[2], *b.shape[2:])\\n\\n\\n# ------------------------------------------------------------------ data\\ndef load_xy(kind, path):\\n    d = np.load(path)\\n    x = sos_norm(d['x'].astype(np.float32))[:, None]                        # (n,1,64,64)\\n    if kind == 'rd':\\n        return np.concatenate([sos_norm(d['l1'])[:, None], sos_norm(d['l2'])[:, None]], 1).astype(np.float32), x\\n    if kind == 'dolce':\\n        return sos_norm(d['l2'])[:, None].astype(np.float32), x\\n    if kind == 'unetR':\\n        return np.concatenate([sos_norm(d['l1'])[:, None], sos_norm(d['l2'])[:, None]], 1).astype(np.float32), x\\n    if kind == 'direct':\\n        b = d['b'].astype(np.float32) / B_SCALE; w = d['w'].astype(np.float32)\\n        return np.concatenate([b, w], 1), x\\n    v = kind.split('_')[1]\\n    cond = refiner_inputs(d['b'].astype(np.float32), d['w'].astype(np.float32), d['l1'].astype(np.float32), v)\\n    y = (d['Ax'].astype(np.float32) / B_SCALE).reshape(-1, 1, *d['Ax'].shape[2:])\\n    return cond, y\\n\\n\\n# ------------------------------------------------------------------ training\\ndef train(kind, data, epochs, out, init=None, bs=64, lr=None, lr_end=None, val_frac=0.05, seed=0, log=print):\\n    torch.manual_seed(seed); np.random.seed(seed)\\n    dev = 'cuda' if torch.cuda.is_available() else 'cpu'\\n    model, diff, desc = build(kind)\\n    if init:\\n        model.load_state_dict(torch.load(init, map_location='cpu')['model'])\\n    model = model.to(dev)\\n    if diff is not None: diff.to(dev)\\n    ema = copy.deepcopy(model).eval()\\n    cond, y = load_xy(kind, data)\\n    n = len(y); nv = max(1, int(val_frac * n))\\n    perm = np.random.permutation(n); vi, ti = perm[:nv], perm[nv:]\\n    C = torch.from_numpy(cond); Y = torch.from_numpy(y)\\n    is_ref = kind.startswith('mu_') or kind.startswith('md_')\\n    lr = lr or (1e-4 if is_ref else 1e-3)\\n    lr_end = lr_end or lr / 100\\n    opt = torch.optim.Adam(model.parameters(), lr=lr)\\n    steps = epochs * max(1, len(ti) // bs)\\n    sched = torch.optim.lr_scheduler.LambdaLR(opt, lambda s: (lr_end / lr) ** min(1.0, s / max(1, steps)))\\n    scaler = torch.cuda.amp.GradScaler(enabled=(dev == 'cuda'))\\n    log(f'[{kind}] {desc}  params={count_params(model):.1f}M  n_train={len(ti)} n_val={nv}  epochs={epochs}')\\n    t0 = time.time(); best = 1e9\\n    for ep in range(epochs):\\n        model.train()\\n        idx = np.random.permutation(ti)\\n        tl = 0.0; nbat = 0\\n        for s in range(0, len(idx) - bs + 1 if len(idx) >= bs else 1, bs):\\n            j = torch.from_numpy(idx[s:s + bs])\\n            c = C[j].to(dev, non_blocking=True); yy = Y[j].to(dev, non_blocking=True)\\n            c, yy = _augment(c, yy, kind)\\n            with torch.autocast('cuda', dtype=torch.float16, enabled=(dev == 'cuda')):\\n                if diff is not None:\\n                    loss = diff.loss(model, yy, c)\\n                else:\\n                    pred = model(c)\\n                    loss = F.l1_loss(pred, yy) if is_ref else F.mse_loss(pred, yy)\\n            opt.zero_grad(set_to_none=True)\\n            scaler.scale(loss).backward()\\n            scaler.unscale_(opt); torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\\n            scaler.step(opt); scaler.update(); sched.step()\\n            gstep = ep * max(1, len(ti) // bs) + nbat\\n            decay = min(0.999, (1 + gstep) / (10 + gstep))           # EMA warm-up (short fine-tunes)\\n            with torch.no_grad():\\n                for pe, pm in zip(ema.parameters(), model.parameters()):\\n                    pe.mul_(decay).add_(pm.detach(), alpha=1 - decay)\\n            tl += loss.item(); nbat += 1\\n        if (ep + 1) % max(1, epochs // 20) == 0 or ep == epochs - 1:\\n            vt = torch.from_numpy(vi)\\n            vl = _val(ema if diff is not None else model, diff, C[vt].to(dev), Y[vt].to(dev), is_ref)\\n            log(f'[{kind}] ep {ep + 1}/{epochs}  train {tl / max(nbat, 1):.4f}  val {vl:.4f}  lr {sched.get_last_lr()[0]:.1e}  {time.time() - t0:.0f}s')\\n    os.makedirs(os.path.dirname(out) or '.', exist_ok=True)\\n    final = ema if diff is not None else model\\n    torch.save({'model': final.state_dict(), 'kind': kind}, out)\\n    log(f'[{kind}] saved {out}')\\n    return out\\n\\n\\ndef _augment(c, y, kind):\\n    \\\"\\\"\\\"Left-right flips. Valid for image-domain models; refiner/direct inputs are\\n    per-pair delay maps whose geometry is not mirror-symmetric pair-wise, so they are not flipped.\\\"\\\"\\\"\\n    if kind in ('rd', 'dolce', 'unetR'):\\n        f = torch.rand(c.shape[0], device=c.device) < 0.5\\n        c = torch.where(f[:, None, None, None], c.flip(-1), c); y = torch.where(f[:, None, None, None], y.flip(-1), y)\\n    return c, y\\n\\n\\n@torch.no_grad()\\ndef _val(model, diff, c, y, is_ref):\\n    model.eval()\\n    out = 0.0\\n    for s in range(0, len(y), 64):\\n        cc, yy = c[s:s + 64], y[s:s + 64]\\n        if diff is not None:\\n            torch.manual_seed(0)\\n            out += diff.loss(model, yy, cc, p_uncond=0.0).item() * len(yy)\\n        else:\\n            p = model(cc)\\n            out += (F.l1_loss(p, yy) if is_ref else F.mse_loss(p, yy)).item() * len(yy)\\n    return out / len(y)\\n\\n\\ndef load_model(path, device='cuda'):\\n    ck = torch.load(path, map_location='cpu')\\n    model, diff, _ = build(ck['kind'])\\n    model.load_state_dict(ck['model'])\\n    model = model.to(device).eval()\\n    if diff is not None: diff.to(device)\\n    return model, diff\\n\\n\\nif __name__ == '__main__':\\n    ap = argparse.ArgumentParser()\\n    ap.add_argument('--model', required=True); ap.add_argument('--data', required=True)\\n    ap.add_argument('--epochs', type=int, default=100); ap.add_argument('--out', required=True)\\n    ap.add_argument('--init', default=None); ap.add_argument('--bs', type=int, default=64)\\n    ap.add_argument('--lr', type=float, default=None); ap.add_argument('--lr_end', type=float, default=None)\\n    a = ap.parse_args()\\n    train(a.model, a.data, a.epochs, a.out, a.init, a.bs, a.lr, a.lr_end, log=lambda s: print(s, flush=True))\\n\", \"sosbench/viz.py\": \"\\\"\\\"\\\"Plotting helpers for the notebooks.\\\"\\\"\\\"\\nimport numpy as np\\nimport matplotlib.pyplot as plt\\n\\nfrom .metrics import all_metrics\\n\\n\\ndef show_maps(maps, geo, gt=None, vmin=1440, vmax=1620, ncol=6, title=None, bmode=None, size=2.6, metric_keys=('RMSE', 'ACE')):\\n    \\\"\\\"\\\"maps: {name: (64,64) SoS}.  Annotates RMSE (ACE) when gt is given.\\\"\\\"\\\"\\n    items = []\\n    if bmode is not None: items.append(('B-mode', bmode))\\n    if gt is not None and np.isfinite(gt).all(): items.append(('Ground truth', gt))\\n    items += list(maps.items())\\n    n = len(items); ncol = min(ncol, n); nrow = int(np.ceil(n / ncol))\\n    fig, axs = plt.subplots(nrow, ncol, figsize=(size * ncol, size * 1.15 * nrow), squeeze=False)\\n    ext = geo.extent_mm\\n    for ax, (name, img) in zip(axs.ravel(), items):\\n        if name == 'B-mode':\\n            ax.imshow(img, cmap='gray', vmin=-50, vmax=0, extent=ext, aspect='auto')\\n        else:\\n            im = ax.imshow(img, cmap='jet', vmin=vmin, vmax=vmax, extent=ext, aspect='auto')\\n            if gt is not None and np.isfinite(gt).all() and name != 'Ground truth':\\n                m = all_metrics(img, gt, geo)\\n                name = name + '\\\\n' + ' / '.join(f'{k} {m[k]:.1f}' for k in metric_keys if k in m)\\n        ax.set_title(name, fontsize=8); ax.set_xticks([]); ax.set_yticks([])\\n    for ax in axs.ravel()[n:]: ax.axis('off')\\n    fig.colorbar(im, ax=axs.ravel().tolist(), shrink=0.6, label='SoS [m/s]')\\n    if title: fig.suptitle(title)\\n    return fig\\n\\n\\ndef show_obs(obs, geo, w=None, pairs=(0, 3, 4, 7), vlim=30, title=None):\\n    \\\"\\\"\\\"obs: {name: (8,64,64) delays [ns]}.\\\"\\\"\\\"\\n    names = list(obs)\\n    fig, axs = plt.subplots(len(names), len(pairs), figsize=(2.4 * len(pairs), 2.4 * len(names)), squeeze=False)\\n    for i, n in enumerate(names):\\n        for j, k in enumerate(pairs):\\n            img = obs[n][k].copy()\\n            if w is not None and i == 0: img = np.where(w[k] > 0, img, np.nan)\\n            im = axs[i, j].imshow(img, cmap='RdBu_r', vmin=-vlim, vmax=vlim, extent=geo.extent_mm, aspect='auto')\\n            axs[i, j].set_xticks([]); axs[i, j].set_yticks([])\\n            if j == 0: axs[i, j].set_ylabel(n, fontsize=8)\\n            if i == 0: axs[i, j].set_title(f'pair {k}', fontsize=8)\\n    fig.colorbar(im, ax=axs.ravel().tolist(), shrink=0.6, label='delay [ns]')\\n    if title: fig.suptitle(title)\\n    return fig\\n\\n\\ndef table_frame(table, metrics=('RMSE', 'ACE', 'gCNR')):\\n    \\\"\\\"\\\"{(input, recon): {metric: (mean, std)}} -> pandas DataFrame 'mean \\u00b1 std'.\\\"\\\"\\\"\\n    import pandas as pd\\n    rows = {}\\n    for (inp, rc), v in table.items():\\n        for m in metrics:\\n            if m in v:\\n                rows.setdefault((inp, m), {})[rc] = f'{v[m][0]:.2f} \\u00b1 {v[m][1]:.2f}'\\n    return pd.DataFrame(rows).T\\n\", \"sosbench/wavesim.py\": \"\\\"\\\"\\\"Wave-based pulse-echo simulator (split-step Fourier / angular-spectrum Born model).\\n\\nPlays the role of DenOiS' \\\"complex in-silico\\\" k-Wave dataset (C): it includes\\ndiffraction, refraction-like phase-screen effects and finite-aperture physics that\\nthe straight-ray operator A' ignores, but runs in ~1 s per case on a T4.\\n\\n    downward:  T(z+dz) = S * IFFT_x[ H * FFT_x[ W T(z) ] ]           (transmit field)\\n    upward  :  U(z)    = S * IFFT_x[ H * FFT_x[ W U(z+dz) ] ] + T(z) r(z)   (Born echoes)\\n    H = exp(-i 2pi dz sqrt((f*smean)^2 - kx^2)),  S = exp(-i 2pi f dz (s - smean))\\nDelays correspond to exp(-i 2pi f tau) (numpy FFT convention), consistent with acq.py.\\n\\\"\\\"\\\"\\nimport numpy as np\\n\\nfrom .acq import Geometry\\n\\n\\nclass SimConfig:\\n    def __init__(self, geo: Geometry, fc=8e6, frac_bw=0.75, dx_sim=None, dz_sim=None, x_span=38.4e-3,\\n                 z_max=None, fs_out=16e6, f_chunk=None, ord_aa=50, el_width_frac=0.9):\\n        self.geo = geo\\n        self.fc = fc\\n        pitch = float(np.mean(np.diff(geo.elx)))\\n        self.dx = dx_sim or pitch / 2\\n        self.dz = dz_sim or 0.1e-3\\n        nx = int(round(x_span / self.dx)); nx += nx % 2\\n        self.nx = nx\\n        self.x = geo.xc + (np.arange(nx) - (nx - 1) / 2) * self.dx\\n        # snap elements to the nearest grid node\\n        self.el_idx = np.array([np.argmin(np.abs(self.x - e)) for e in geo.elx])\\n        # finite element width: each element covers `el_nodes` grid nodes (directivity,\\n        # suppresses grating lobes like a real / k-Wave element)\\n        w = max(1, int(round(el_width_frac * pitch / self.dx)))\\n        off = np.arange(w) - (w - 1) // 2\\n        self.el_nodes = np.clip(self.el_idx[:, None] + off[None, :], 0, nx - 1)     # (nel, w)\\n        self.z_max = z_max or (geo.nz * geo.dz + 1.5e-3)\\n        self.nz = int(np.ceil(self.z_max / self.dz))\\n        self.z = np.arange(self.nz) * self.dz\\n        self.fs_out = fs_out\\n        t_max = 2.2 * self.z_max / 1380 + 4e-6\\n        self.nt = int(np.ceil(t_max * fs_out / 16) * 16)\\n        self.T = self.nt / fs_out\\n        df = 1 / self.T\\n        sig = frac_bw * fc / 2.355                                        # Gaussian pulse spectrum\\n        f = np.arange(int((fc - 2.5 * sig) / df), int((fc + 2.5 * sig) / df) + 1) * df\\n        self.f = f[f > 0.5e6]\\n        self.P = np.exp(-0.5 * ((self.f - fc) / sig) ** 2).astype(np.float32)\\n        self.f_chunk = f_chunk or 48\\n        xmax = (np.abs(geo.elx - geo.xc).max() + np.abs(self.x - geo.xc).max()) / 2\\n        self.aawin = (1 / np.sqrt(1 + ((self.x - geo.xc) / xmax) ** ord_aa)).astype(np.float32)\\n        self.t_out = np.arange(self.nt) / fs_out\\n\\n\\ndef simulate_pw_iq(B, cfg: SimConfig, sos, refl):\\n    \\\"\\\"\\\"sos, refl: (cfg.nz, cfg.nx) arrays (refl complex). Returns baseband IQ\\n    channel data (nang, nel, nt) and t_out \\u2014 same format as acq.fsa_to_pw_iq.\\\"\\\"\\\"\\n    geo = cfg.geo\\n    nang = geo.n_tx; nel = len(geo.elx)\\n    kx = B.asarray(np.fft.fftfreq(cfg.nx, cfg.dx).astype(np.float32))\\n    s = B.asarray((1.0 / sos).astype(np.float32))                          # (nz, nx)\\n    smean = B.mean(s, axis=1, keepdims=True)                               # (nz, 1)\\n    ds = s - smean\\n    refl = B.asarray(refl.astype(np.complex64))\\n    W = B.asarray(cfg.aawin)\\n    el_idx = cfg.el_idx\\n    # transmit delays / apodisation (programmed with c_bf)\\n    tau = geo.tx_delay.astype(np.float32); apod = geo.tx_apod.astype(np.float32)\\n    Y = []                                                                 # per freq chunk: (nang, nfc, nel)\\n    fchunk = cfg.f_chunk if B.name == 'numpy' else max(cfg.f_chunk, 128)      # bigger chunks on GPU\\n    for f0 in range(0, len(cfg.f), fchunk):\\n        fnp = cfg.f[f0:f0 + fchunk]\\n        f = B.asarray(fnp.astype(np.float32))\\n        nf = len(fnp)\\n        # boundary transmit field at z=0: delta at each element with programmed delay\\n        T0 = np.zeros((nang, nf, cfg.nx), np.complex64)\\n        ph = np.exp(-2j * np.pi * fnp[None, :, None] * tau[:, None, :]) * cfg.P[f0:f0 + nf][None, :, None] * apod[:, None, :]\\n        for j in range(cfg.el_nodes.shape[1]):\\n            T0[:, :, cfg.el_nodes[:, j]] += ph / cfg.el_nodes.shape[1]\\n        Tz = B.asarray(T0)\\n        # store source terms T(z) * r(z) for every depth\\n        srcs = []\\n        for iz in range(cfg.nz):\\n            srcs.append(Tz * refl[iz][None, None, :])\\n            if iz < cfg.nz - 1:\\n                Tz = _step(B, Tz, f, kx, smean[iz], ds[iz], cfg.dz, W)\\n        U = B.zeros((nang, nf, cfg.nx), B.cfloat)\\n        for iz in range(cfg.nz - 1, -1, -1):\\n            U = U + srcs[iz]\\n            if iz > 0:\\n                U = _step(B, U, f, kx, smean[iz - 1], ds[iz - 1], cfg.dz, W)\\n        del srcs\\n        Yc = 0\\n        for j in range(cfg.el_nodes.shape[1]):\\n            Yc = Yc + U[:, :, B.asarray(cfg.el_nodes[:, j])]\\n        Y.append(Yc / cfg.el_nodes.shape[1])                               # (nang, nf, nel)\\n    Y = B.cat(Y, axis=1)\\n    # baseband synthesis  iq(t) = sum_f Y(f) exp(i2pi f t) exp(-i2pi fc t)\\n    E = np.exp(2j * np.pi * (cfg.f[:, None] - cfg.fc) * cfg.t_out[None, :]).astype(np.complex64)\\n    E = B.asarray(E)\\n    iq = B.einsum('afe,fn->aen', Y, E)\\n    return iq, cfg.t_out\\n\\n\\ndef _step(B, F, f, kx, smean, ds, dz, W):\\n    \\\"\\\"\\\"One split-step of the field F (nang, nf, nx) through a layer of thickness dz.\\\"\\\"\\\"\\n    kz2 = (f[:, None] * smean) ** 2 - kx[None, :] ** 2                     # (nf, nx)\\n    prop = (kz2 > 0)\\n    kz = B.sqrt(B.clip(kz2, 0, None))\\n    H = B.polar(-2 * np.pi * kz * dz) * (prop.astype(np.float32) if B.name == 'numpy' else prop.float())\\n    S = B.polar(-2 * np.pi * f[:, None] * ds[None, :] * dz)                 # (nf, nx)\\n    return S[None] * W * B.ifft(H[None] * B.fft(W * F, axis=-1), axis=-1)\\n\\n\\ndef make_medium(rng, cfg: SimConfig, sos_img, img_extent, echo=None, speckle_density=1.0):\\n    \\\"\\\"\\\"Interpolate an SoS map defined on the recon field of view (img_extent =\\n    (z0,z1,x0,x1) [m]) to the simulation grid (edge-extended), and draw a random\\n    complex reflectivity (speckle x echogenicity).\\\"\\\"\\\"\\n    from scipy.ndimage import map_coordinates\\n    nzi, nxi = sos_img.shape\\n    z0, z1, x0, x1 = img_extent\\n    fz = (cfg.z - z0) / (z1 - z0) * nzi - 0.5\\n    fx = (cfg.x - x0) / (x1 - x0) * nxi - 0.5\\n    ZZ, XX = np.meshgrid(fz, fx, indexing='ij')\\n    sos = map_coordinates(sos_img, [ZZ, XX], order=1, mode='nearest').astype(np.float32)\\n    amp = np.ones_like(sos) if echo is None else map_coordinates(echo, [ZZ, XX], order=1, mode='nearest')\\n    r = (rng.standard_normal(sos.shape) + 1j * rng.standard_normal(sos.shape)) * amp * speckle_density\\n    r[cfg.z < 0.5e-3] = 0                                                  # no scatterers at the lens\\n    return sos, r.astype(np.complex64)\\n\"}\nfor fn, src in FILES.items():\n    os.makedirs(os.path.dirname(os.path.join(WORK, fn)), exist_ok=True)\n    with open(os.path.join(WORK, fn), 'w') as f:\n        f.write(src)\nsys.path.insert(0, WORK)\nimport numpy as np, torch, matplotlib.pyplot as plt\nNGPU = torch.cuda.device_count()\nprint('torch', torch.__version__, '| GPUs:', [torch.cuda.get_device_name(i) for i in range(NGPU)])\nassert NGPU >= 1, 'Enable a GPU accelerator (Settings -> Accelerator -> GPU T4 x2)'","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T12:21:23.275205Z","iopub.execute_input":"2026-10-14T12:21:23.275841Z","iopub.status.idle":"2026-10-14T12:21:29.651206Z","shell.execute_reply.started":"2026-10-14T12:21:23.275811Z","shell.execute_reply":"2026-10-14T12:21:29.650359Z"}},"outputs":[{"name":"stdout","text":"torch 2.11.0+cu128 | GPUs: ['Tesla T4', 'Tesla T4']\n","output_type":"stream"}],"execution_count":1},{"id":"bf357748-4802-4d22-a084-68a5fef15630","cell_type":"code","source":"MODE = 'quick'            # 'quick' = tiny end-to-end run (~25 min) | 'full' = paper-style run\nC = dict(\n    full=dict(N_S=10000, N_C1=620, N_C1val=16, N_C1test=30, N_C2=30,\n              ep=dict(rd_S=150, rd_C=100, dolce_S=150, dolce_C=100, unetR
ata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"d078fd05-1dbc-4c48-a3cc-441b09ff6cdc","cell_type":"code","source":"# Abdominal 3 / 4 (k-Wave, ground truth): every input x reconstruction combination\nfor name in ['abd3', 'abd4']:\n    if 'metrics' not in res.get(name, {}): continue\n    rows = {k: {'RMSE': v['RMSE'], 'MAE': v['MAE']} for k, v in res[name]['metrics'].items()}\n    import pandas as pd\n    df = pd.DataFrame(rows).T.sort_values('RMSE')\n    display(Markdown(f'### {name}: SoS error vs ground truth (thesis ROI x in [-12,12] mm, z in [0,38.4] mm)'))\n    display(df.round(2))","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"ea5da5c2-50e4-4da4-a76e-4ace2b90030d","cell_type":"code","source":"# Figures: sample reconstructions (C2), the public cases, and refined observations\nSHOW = [\"b'|L2-TV\", \"b'|L1-TV\", \"b'|Unet[5]\", \"b'|Dolce\", \"MU(b',P,A'x')|Unet(MU)\", \"b'|RD\",\n        \"MU(b',P,A'x')|RD\", \"MD(b',P,A'x')|RD\"]\ndef pick(z):\n    return {k.replace(\"|\", \"\\n\"): z[k] for k in SHOW if k in z.files}\ngeo = default_geometry()\nif os.path.exists(f'{RES}/C2_recons.npz'):\n    z = np.load(f'{RES}/C2_recons.npz')\n    for i in range(min(3, len(z['gt']))):\n        show_maps({k: v[i] for k, v in pick(z).items()}, geo, gt=z['gt'][i], ncol=9, size=2.0, title=f'C2 case {i}'); plt.show()\nfor name in ['abd3', 'abd4', 'phantom', 'rat']:\n    p = f'{RES}/{name}_recons.npz'\n    if not os.path.exists(p): continue\n    z = np.load(p)\n    show_maps(pick(z), geo, gt=z['gt'], ncol=9, size=2.0, title=name, vmin=1420, vmax=1640); plt.show()\n    obs = {\"acquired b'\": z['b']}\n    obs.update({k[4:]: z[k] for k in z.files if k.startswith('obs|')})\n    show_obs(obs, geo, w=z['w'], title=f'{name}: acquired vs refined delays'); plt.show()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"f152ece5-f203-4edf-ac92-ebe6848629ab","cell_type":"code","source":"# \"Is DenOiS working?\" - automatic checks of the paper's main claims on OUR runs\ndef get(tab, i, r, m):\n    v = tab.get((i, r)); return None if v is None or m not in v else v[m][0]\nchecks = []\nfor name, tab in TABS.items():\n    ref = \"MU(b',P,A'x')\"\n    for metric in ('RMSE', 'ACE'):\n        a, b_ = get(tab, \"b'\", 'L1-TV', metric), get(tab, ref, 'L1-TV', metric)\n        if a and b_: checks.append((name, f'refinement improves L1-TV {metric}', b_ < a, f'{a:.2f} -> {b_:.2f}'))\n    for base in ('L1-TV', 'L2-TV', 'Dolce', 'Unet(MU)'):\n        best_rd = min([x for x in [get(tab, ref, 'RD', 'ACE'), get(tab, \"MD(b',P,A'x')\", 'RD', 'ACE')] if x is not None], default=None)\n        bb = min([x for x in [get(tab, i_, base, 'ACE') for i_ in [\"b'\", ref]] if x is not None], default=None)\n        if best_rd and bb: checks.append((name, f'DenOiS R_D beats {base} on ACE', best_rd < bb, f'{bb:.2f} vs {best_rd:.2f}'))\n    u5 = get(tab, \"b'\", 'Unet[5]', 'ACE'); rd0 = get(tab, \"b'\", 'RD', 'ACE')\n    if u5 and rd0: checks.append((name, 'direct Unet[5] loses contrast (paper: it fails)', u5 > rd0, f'ACE {u5:.2f} vs R_D {rd0:.2f}'))\nfor name in ['abd3', 'abd4']:\n    mt = res.get(name, {}).get('metrics', {})\n    a, b_ = mt.get(\"b'|L1-TV\"), mt.get(\"MU(b',P,A'x')|RD\")\n    if a and b_: checks.append((name, 'DenOiS R_D(M_U) beats L1-TV (RMSE)', b_['RMSE'] < a['RMSE'], f\"{a['RMSE']:.2f} -> {b_['RMSE']:.2f}\"))\nimport pandas as pd\ndisplay(pd.DataFrame(checks, columns=['data', 'claim', 'holds', 'numbers']))\njson.dump({'checks': [(a, b, bool(c), d) for a, b, c, d in checks]}, open(f'{RES}/checks.json', 'w'), indent=1)\nprint('Results saved in', os.path.abspath(RES), '- notebook 2 reads them from here (or from this notebook\\'s output).')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"5a62ed0d-5790-4919-9362-91ea0752ddde","cell_type":"code","source":"# === Save results to GitHub, then release the GPU ===================================\nGH_USER   = 'your-github-username'\nGH_REPO   = 'your-repo-name'          # must already exist (private is fine)\nGH_BRANCH = 'main'\nGH_EMAIL  = 'your-github-username@users.noreply.github.com'\n\nimport os, glob, shutil, subprocess, datetime, json\nimport matplotlib.pyplot as plt\nfrom kaggle_secrets import UserSecretsClient\ntoken = UserSecretsClient().get_secret('GITHUB_TOKEN')\n\n# 1) save the key figures as PNGs (notebook figures are not files otherwise)\nfrom sosbench.acq import default_geometry\nfrom sosbench.viz import show_maps\ngeo = default_geometry(); figdir = f'{RES}/figures'; os.makedirs(figdir, exist_ok=True)\nfor name in ['C2', 'C1test', 'abd3', 'abd4', 'phantom', 'rat']:\n    p = f'{RES}/{name}_recons.npz'\n    if not os.path.exists(p): continue\n    z = np.load(p)\n    keys = [k for k in z.files if '|' in k and not k.startswith('obs|')]\n    i = (lambda a: a[0] if a.ndim == 3 else a)\n    fig = show_maps({k.replace('|', '\\n'): i(z[k]) for k in keys}, geo, gt=i(z['gt']), ncol=8, size=2.0, title=name)\n    fig.savefig(f'{figdir}/{name}.png', dpi=110, bbox_inches='tight'); plt.close(fig)\n\n# 2) clone repo, copy results (skip anything >95 MB: GitHub's 100 MB file limit)\nurl = f'https://{GH_USER}:{token}@github.com/{GH_USER}/{GH_REPO}.git'\nrepo = '/kaggle/temp_repo'; shutil.rmtree(repo, ignore_errors=True)\ndef run(cmd, **kw):\n    r = subprocess.run(cmd, shell=True, capture_output=True, text=True, **kw)\n    print((r.stdout + r.stderr).replace(token, '***')[-1500:]); return r\nrun(f'git clone --depth 1 -b {GH_BRANCH} {url} {repo}')\nstamp = datetime.datetime.now().strftime('%Y-%m-%d_%H%M')\ndst = f'{repo}/denois_runs/{stamp}'; os.makedirs(dst, exist_ok=True)\nto_copy = glob.glob(f'{RES}/**/*', recursive=True) + glob.glob('log_*.txt') + glob.glob(f'{CKPT}/*.pt')\nfor f in to_copy:\n    if os.path.isfile(f) and os.path.getsize(f) < 95e6:\n        os.makedirs(os.path.join(dst, os.path.dirname(f)), exist_ok=True)\n        shutil.copy(f, os.path.join(dst, f))\njson.dump({'mode': MODE, 'saved': stamp}, open(f'{dst}/run_info.json', 'w'))\n\n# 3) commit + push\nrun(f'git -C {repo} config user.name \"{GH_USER}\" && git -C {repo} config user.email \"{GH_EMAIL}\"')\nrun(f'git -C {repo} add -A && git -C {repo} commit -m \"DenOiS Kaggle run {stamp}\"')\nr = run(f'git -C {repo} push origin {GH_BRANCH}')\nprint('PUSHED OK' if r.returncode == 0 else 'PUSH FAILED - results are still in /kaggle/working')\n\n# 4) free the GPU: stop background jobs and kill this kernel\nif r.returncode == 0:\n    subprocess.run('pkill -f sosbench', shell=True)\n    os._exit(0)","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}